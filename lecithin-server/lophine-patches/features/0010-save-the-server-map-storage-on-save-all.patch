Subject: [PATCH] save the server map storage on save-all


diff --git a/src/main/java/fun/bm/lophine/utils/SaveAllUtil.java b/src/main/java/fun/bm/lophine/utils/SaveAllUtil.java
index 48735320b3930274e3a72c1b0129e4ab54b60182..6b3ed9a9bf07164ee9e5364b9f52b0e46fa979e6 100644
--- a/src/main/java/fun/bm/lophine/utils/SaveAllUtil.java
+++ b/src/main/java/fun/bm/lophine/utils/SaveAllUtil.java
@@ -38,6 +38,8 @@ public class SaveAllUtil {
                 savedRegionCount.set(0);
                 withError.set(false);
                 lastSaveAllTime = System.currentTimeMillis();
+                // Lecithin - region saves below never touch the server storage holding map data and last_id; save it on the next global tick
+                io.papermc.paper.threadedregions.RegionizedServer.requestMapSave();
             }
         }
     }
