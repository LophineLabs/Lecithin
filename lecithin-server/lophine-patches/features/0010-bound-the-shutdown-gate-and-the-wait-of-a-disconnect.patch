+    /**
+     * Where a job was registered is the one thing that says what it is when it never finishes: kept
+     * only while the job is pending, and cheap because just the first frames past the trackers are walked.
+     */
+    private record Tracked(List<StackWalker.StackFrame> origin, long since) {
+    }
+
+    public static List<StackWalker.StackFrame> captureOrigin() {
+        return ORIGIN.walk(frames -> frames.dropWhile(frame -> TRACKERS.contains(frame.getClassName())).limit(3).toList());
+    }
+
+    /**
+     * Reads no thread-bound owner state, so the gates can call it from any thread.
+     */
+    public static String describe(CompletableFuture<?> job, List<StackWalker.StackFrame> origin, long sinceNanos) {
+        String from = origin == null || origin.isEmpty() ? "unknown" : origin.stream()
+                .map(frame -> frame.getClassName().substring(frame.getClassName().lastIndexOf('.') + 1) + "." + frame.getMethodName() + ":" + frame.getLineNumber())
+                .collect(java.util.stream.Collectors.joining(" < "));
+        return String.format(java.util.Locale.ROOT, "%s, pending %.1f s, registered at %s", ScarpetNativeWork.describeOwner(job), (System.nanoTime() - sinceNanos) / 1_000_000_000D, from);
+    }
+
+    /**
+     * One line per unfinished job, oldest first: the oldest is the most likely cause of the rest.
+     */
+    public static List<String> describePending(MinecraftServer server) {
+        var lines = new ArrayList<String>();
+        var jobs = new ArrayList<>(CALLERS.getOrDefault(server, Map.of()).entrySet());
+        jobs.removeIf(entry -> entry.getKey().isDone());
+        jobs.sort(java.util.Comparator.comparingLong(entry -> entry.getValue().since()));
+        for (var job : jobs.subList(0, Math.min(jobs.size(), MAX_DESCRIBED)))
+            lines.add("unfinished native job: " + describe(job.getKey(), job.getValue().origin(), job.getValue().since()));
+        if (jobs.size() > MAX_DESCRIBED) lines.add("and " + (jobs.size() - MAX_DESCRIBED) + " newer native jobs");
+        synchronized (PENDING) {
+            PENDING.values().stream().filter(plan -> plan.server == server && !plan.completed.isDone()).forEach(plan ->
+                    lines.add("unfinished removal callback: " + ScarpetNativeWork.describeEntity(plan.entity)));
+        }
+        return lines;
+    }
+
