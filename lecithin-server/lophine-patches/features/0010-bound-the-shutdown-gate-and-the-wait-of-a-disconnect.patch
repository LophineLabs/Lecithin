diff --git a/src/main/java/fun/bm/lophine/carpet/CarpetShutdownGate.java b/src/main/java/fun/bm/lophine/carpet/CarpetShutdownGate.java
new file mode 100644
index 0000000000000000000000000000000000000000..f3a1edd34e351b0bfda59d69717f9153e7f12575
--- /dev/null
+++ b/src/main/java/fun/bm/lophine/carpet/CarpetShutdownGate.java
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: MIT
+package fun.bm.lophine.carpet;
+
+import carpet.script.external.ScarpetNativeRemovals;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerPlayer;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import java.util.function.BooleanSupplier;
+import java.util.function.LongSupplier;
+
+/**
+ * The one deadline for everything between a stop request and Folia's region shutdown thread.
+ *
+ * <p>Native Carpet work keeps the region schedulers running until it drains, so one job that never
+ * completes used to keep the server alive with idle tick threads, no shutdown thread and no plugin
+ * disable. A failed region is worse: it halts the schedulers first, so whatever the gate waits on
+ * can never run. This gate only releases the wait; plugin disable and every save still follow.
+ */
+public final class CarpetShutdownGate {
+    private static final org.slf4j.Logger LOGGER = org.slf4j.LoggerFactory.getLogger("Shutdown");
+    private static final long RECHECK_NANOS = TimeUnit.SECONDS.toNanos(1);
+    /**
+     * Once a failed region has halted every tick thread only off-region tails, such as a file
+     * write already in flight, can still finish.
+     */
+    private static final long HALTED_GRACE_NANOS = TimeUnit.SECONDS.toNanos(5);
+    private static final carpet.script.external.WeakIdentityMap<MinecraftServer, CarpetShutdownGate> GATES =
+            new carpet.script.external.WeakIdentityMap<>();
+
+    /**
+     * The waits run in this order and share one deadline. Each may use time up to its share, so a
+     * stuck earlier wait still leaves the later saves their turn while they can still run.
+     */
+    public enum Stage {
+        LOGINS("player logins", 0.50D),
+        NATIVE_WORK("native work and resident profiles", 0.85D),
+        PLAYER_REGISTRIES("fake player removal", 1.00D);
+
+        private final String description;
+        private final double share;
+
+        Stage(String description, double share) {
+            this.description = description;
+            this.share = share;
+        }
+    }
+
+    /**
+     * Package-private so a test can drive expiry without real time.
+     */
+    @FunctionalInterface
+    interface Timer {
+        void schedule(long nanos, Runnable expire);
+    }
+
+    static volatile Timer timer = (nanos, expire) ->
+            CompletableFuture.delayedExecutor(nanos, TimeUnit.NANOSECONDS).execute(expire);
+    static volatile LongSupplier clock = System::nanoTime;
+    static volatile BooleanSupplier tickThreadsFailed = () ->
+            io.papermc.paper.threadedregions.TickRegions.getScheduler().tickThreadsFailed();
+
+    private final MinecraftServer server;
+    private final long startNanos = clock.getAsLong();
+    private volatile long haltSeenNanos;
+    private volatile boolean haltSeen;
+
+    private CarpetShutdownGate(MinecraftServer server) {
+        this.server = server;
+    }
+
+    /**
+     * The first call starts the clock; {@link carpet.script.external.ScarpetNativeWork#beginDrain} makes that the stop request itself.
+     */
+    public static CarpetShutdownGate of(MinecraftServer server) {
+        return GATES.computeIfAbsent(server, CarpetShutdownGate::new);
+    }
+
+    private long remainingNanos(Stage stage) {
+        long seconds = fun.bm.lecithin.config.modules.CompatConfig.shutdownGateTimeoutSeconds;
+        if (seconds <= 0) return Long.MAX_VALUE;
+        long now = clock.getAsLong();
+        long remaining = (long) (TimeUnit.SECONDS.toNanos(seconds) * stage.share) - (now - startNanos);
+        if (!tickThreadsFailed.getAsBoolean()) return remaining;
+        if (!haltSeen) {
+            haltSeenNanos = now;
+            haltSeen = true;
+        }
+        return Math.min(remaining, HALTED_GRACE_NANOS - (now - haltSeenNanos));
+    }
+
+    /**
+     * A view of the work that ends with it or at this stage's share of the deadline, whichever is first.
+     * Work that is already done keeps its exact synchronous path.
+     */
+    public <T> CompletableFuture<T> bounded(CompletableFuture<T> work, Stage stage) {
+        if (work.isDone()) return work;
+        var view = new CompletableFuture<T>();
+        work.whenComplete((value, failure) -> {
+            if (failure == null) view.complete(value);
+            else view.completeExceptionally(failure);
+        });
+        arm(view, stage);
+        return view;
+    }
+
+    private void arm(CompletableFuture<?> view, Stage stage) {
+        long remaining = remainingNanos(stage);
+        if (view.isDone()) return;
+        if (remaining <= 0) {
+            if (view.complete(null)) report(stage);
+            return;
+        }
+        // Rechecks because a region can fail, and halt every tick thread, in the middle of this wait.
+        timer.schedule(Math.min(remaining, RECHECK_NANOS), () -> arm(view, stage));
+    }
+
+    private void report(Stage stage) {
+        double waited = (clock.getAsLong() - startNanos) / 1_000_000_000D;
+        boolean halted = tickThreadsFailed.getAsBoolean();
+        LOGGER.error("Shutdown waited {} s for {}{} and is continuing without it. Still waiting on:",
+                String.format(java.util.Locale.ROOT, "%.1f", waited), stage.description, halted ? " after a failed region halted the tick threads" : "");
+        List<String> lines = pending();
+        if (lines.isEmpty()) LOGGER.error("  (nothing is registered as pending any more)");
+        for (String line : lines) LOGGER.error("  {}", line);
+    }
+
+    private List<String> pending() {
+        var lines = new ArrayList<String>();
+        lines.addAll(CarpetPlayerBirths.describePending(server));
+        lines.addAll(ScarpetNativeRemovals.describePending(server));
+        var players = server.getPlayerList();
+        if (players != null) {
+            for (ServerPlayer player : players.getPlayers())
+                if (player.hasDisconnected()) lines.add("disconnected player still listed: " + player.getScoreboardName());
+        }
+        return lines;
+    }
+}
