+    /**
+     * A disconnected player stays in the player list, holding its name against every new login, until
+     * this wait ends; work that never finishes must not decide that. Expiry only ends the wait: the
+     * removal that follows still hops to the player's owner and runs once, with its quit event and save.
+     * Work that was already done keeps its exact synchronous path.
+     */
+    static CompletableFuture<Void> boundRemovalWait(ServerPlayer player, CompletableFuture<Void> pending) {
+        long bound = fun.bm.lecithin.config.modules.CompatConfig.playerRemovalTimeoutSeconds;
+        if (bound <= 0 || pending.isDone()) return pending;
+        var waited = new CompletableFuture<Void>();
+        pending.whenComplete((ignored, failure) -> waited.complete(null));
+        removalTimer.schedule(bound, () -> {
+            if (waited.isDone()) return;
+            var stuck = of(player).describeAccepted();
+            // Ends a stuck login's custody first: its file lease would stop this account's next login too.
+            fun.bm.lophine.carpet.CarpetPlayerBirths.abandonPlayer(player);
+            if (waited.complete(null))
+                LOGGER.error("{} disconnected but its removal waited {} s for native work and is continuing without it. Still waiting on: {}",
+                        player.getScoreboardName(), bound, stuck);
+        });
+        return waited;
+    }
+
+    /**
+     * A player's scheduler only runs while a region ticks it. If it never runs this removal, fall back
+     * to the region owning the player's position; the body itself still checks it is on the owner.
+     */
+    private static void ownerFallback(ServerPlayer player, java.util.function.Consumer<net.minecraft.world.entity.Entity> body, java.util.concurrent.atomic.AtomicBoolean started) {
+        long bound = fun.bm.lecithin.config.modules.CompatConfig.playerRemovalTimeoutSeconds;
+        if (bound <= 0) return;
+        removalTimer.schedule(bound, () -> {
+            if (started.get()) return;
+            LOGGER.error("{} disconnected but its scheduler has not run its removal in {} s; running it at the region owning its position", player.getScoreboardName(), bound);
+            var position = player.blockPosition();
+            player.level().getServer().server.getRegionScheduler().execute(org.leavesmc.leaves.plugin.MinecraftInternalPlugin.INSTANCE, player.level().getWorld(),
+                    position.getX() >> 4, position.getZ() >> 4, () -> body.accept(player));
+        });
     }
 
