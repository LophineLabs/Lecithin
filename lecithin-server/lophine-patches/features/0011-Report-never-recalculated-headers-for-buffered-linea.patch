From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Thu, 22 Oct 2026 18:03:27 +0800
Subject: [PATCH] Report never-recalculated headers for buffered linear region
 files instead of throwing


diff --git a/src/main/java/io/anonymous/anonymous/data/BufferedLinearRegionFile.java b/src/main/java/io/anonymous/anonymous/data/BufferedLinearRegionFile.java
index 243b419b8edb183149d075d98ddd4da74bb1b896..be19389b2b18a7f22390ac4e214b702496923b9f 100644
--- a/src/main/java/io/anonymous/anonymous/data/BufferedLinearRegionFile.java
+++ b/src/main/java/io/anonymous/anonymous/data/BufferedLinearRegionFile.java
@@ -846,21 +846,27 @@ public class BufferedLinearRegionFile implements io.anonymous.anonymous.data.Reg
         );
     }
 
+    // Lecithin start - linear headers are never recalculated, report that instead of throwing
+    // RegionFileStorage.moonrise$readData()/moonrise$finishRead() query the recalculate count on every
+    // chunk read, and read()/moonrise$finishRead() ask for a recalculation when the stored chunk position
+    // mismatches. Throwing here fails every B_LINEAR chunk read ("chunk data will be lost"), so the
+    // chunk would regenerate and later be saved over the real data.
     @Override
     public int moonrise$getRecalculateCount() {
-        throw new UnsupportedOperationException("stub");
+        return 0;
     }
 
     @Override
     public boolean moonrise$recalculateHeader() throws IOException {
-        throw new UnsupportedOperationException("stub");
+        return false;
     }
 
     @Override
     public Boolean moonrise$tryRecalcHeader(int expectedRecalcCount) throws IOException {
         // we do not need use this to recalac as the swap file is fail-fast
-        throw new UnsupportedOperationException("stub");
+        return Boolean.FALSE;
     }
+    // Lecithin end - linear headers are never recalculated, report that instead of throwing
 
     @Override
     public void flush() throws IOException {
