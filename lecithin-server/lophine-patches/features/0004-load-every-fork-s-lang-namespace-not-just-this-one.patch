+        }
+    }
+
+    /**
+     * Every non-vanilla namespace on the class path that ships a {@code lang} directory, discovered
+     * once and cached. The class path cannot change while the server is running, so this is a fact
+     * rather than a registry that has to be populated before some other class initialises - which
+     * matters because {@code Language.DEFAULT_INSTANCE} is built in a static initialiser that may
+     * run before the config system exists.
+     */
+    private static List<String> langNamespaces() {
+        List<String> cached = langNamespaces;
+        if (cached != null) {
+            return cached;
+        }
+        synchronized (ServerI18nUtil.class) {
+            if (langNamespaces != null) {
+                return langNamespaces;
+            }
+            final Set<String> found = new TreeSet<>();
+            try {
+                discoverLangNamespaces(found);
+            } catch (Exception e) {
+                logger.warn("Failed to enumerate language namespaces, falling back to {}", FALLBACK_NAMESPACES, e);
             }
+            found.removeAll(VANILLA_NAMESPACES);
+            cached = found.isEmpty() ? FALLBACK_NAMESPACES : List.copyOf(found);
+            langNamespaces = cached;
+            return cached;
+        }
+    }
+
+    private static void discoverLangNamespaces(Set<String> out) throws IOException {
+        ClassLoader loader = Language.class.getClassLoader();
+        if (loader == null) {
+            loader = ClassLoader.getSystemClassLoader();
+        }
+        final Enumeration<URL> roots = loader.getResources(ASSETS_ROOT);
+        while (roots.hasMoreElements()) {
+            final URL root = roots.nextElement();
+            try {
+                switch (root.getProtocol()) {
+                    case "jar" -> collectFromJar(root, out);
+                    case "file" -> collectFromDirectory(Path.of(root.toURI()), out);
+                    default -> logger.debug("Skipping unsupported assets root {}", root);
+                }
+            } catch (Exception e) {
+                logger.debug("Failed to read assets root {}", root, e);
+            }
+        }
+    }
+
+    private static void collectFromJar(URL root, Set<String> out) throws IOException {
+        final JarURLConnection connection = (JarURLConnection) root.openConnection();
+        // The JVM caches and shares this JarFile with every other class path reader, so it must not
+        // be closed here.
+        connection.setUseCaches(true);
+        final JarFile jar = connection.getJarFile();
+        final Enumeration<JarEntry> entries = jar.entries();
+        while (entries.hasMoreElements()) {
+            final String name = entries.nextElement().getName();
+            if (!name.startsWith(ASSETS_ROOT) || !name.endsWith(".json")) {
+                continue;
+            }
+            final String relative = name.substring(ASSETS_ROOT.length());
+            final int slash = relative.indexOf('/');
+            if (slash <= 0 || !relative.startsWith("lang/", slash + 1)) {
+                continue;
+            }
+            out.add(relative.substring(0, slash));
+        }
+    }
+
+    private static void collectFromDirectory(Path assetsDir, Set<String> out) throws IOException {
+        if (!Files.isDirectory(assetsDir)) {
+            return;
+        }
+        try (Stream<Path> children = Files.list(assetsDir)) {
+            children.filter(Files::isDirectory).forEach(namespace -> {
+                final Path langDir = namespace.resolve("lang");
+                if (!Files.isDirectory(langDir)) {
+                    return;
+                }
+                try (Stream<Path> files = Files.list(langDir)) {
+                    if (files.anyMatch(file -> file.getFileName().toString().endsWith(".json"))) {
+                        out.add(namespace.getFileName().toString());
+                    }
+                } catch (IOException e) {
+                    logger.debug("Failed to read lang directory {}", langDir, e);
+                }
+            });
         }
     }
+    // Lophine end - load every fork's lang namespace, not just this one
 
