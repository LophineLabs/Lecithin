+    // Lophine start - load every fork's lang namespace, not just this one
+    /**
+     * Loads {@code assets/&lt;namespace&gt;/lang/&lt;lang&gt;.json} for every non-vanilla namespace present on
+     * the server class path, falling back <em>per namespace</em> to that namespace's {@code en_us}.
+     *
+     * <p>This used to be a single hard-coded {@code /assets/lophine/lang/} path, which meant a
+     * downstream fork could ship a lang file under its own namespace - the layout its own
+     * contributing guide asks for, and the layout {@code ConfigsInstance} already assumes when it
+     * builds comment keys as {@code &lt;config instance name&gt;.&lt;key path&gt;.comment} - and have it
+     * silently never loaded. Discovering the namespaces from the class path keeps that generic:
+     * any namespace that ships a {@code lang} directory is picked up, with no fork name, plugin
+     * name or resource path listed anywhere in this class.
+     */
+    private static void loadForkI18n(BiConsumer<String, String> bi, String lang) {
+        for (final String namespace : langNamespaces()) {
+            final String path = "/" + ASSETS_ROOT + namespace + "/lang/" + lang + ".json";
+            if (Language.class.getResource(path) != null) {
+                Language.parseTranslations(bi, path);
+            } else {
+                loadForkI18nDefault(bi, namespace);
             }
         }
     }
 
