+    private static void loadForkI18nDefault(BiConsumer<String, String> bi, String namespace) {
+        final String path = "/" + ASSETS_ROOT + namespace + "/lang/" + Language.DEFAULT + ".json";
+        if (Language.class.getResource(path) != null) {
