From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Sun, 1 Nov 2026 18:26:24 +0800
Subject: [PATCH] do not reload resources for recipe rules on the first config
 load


diff --git a/src/main/java/fun/bm/lophine/carpet/config/modules/GeneralCompatConfig.java b/src/main/java/fun/bm/lophine/carpet/config/modules/GeneralCompatConfig.java
index 1877d33aacc9a4d3a2fa35cd4366b69ea188c265..e3cc3b5d1ed6b2332e30a12280d31dab7504ba3e 100644
--- a/src/main/java/fun/bm/lophine/carpet/config/modules/GeneralCompatConfig.java
+++ b/src/main/java/fun/bm/lophine/carpet/config/modules/GeneralCompatConfig.java
@@ -1812,7 +1812,7 @@ public class GeneralCompatConfig {
         fun.bm.lophine.carpet.ams.AmsFakePlayers.refresh();
         fun.bm.lophine.carpet.CarpetDistanceRuleLifecycle.refresh();
         fun.bm.lophine.carpet.CarpetInventoryRuleLifecycle.refresh();
-        refreshRecipeRules();
+        applyRecipeRules(net.minecraft.server.MinecraftServer.getServer()); // Lecithin - reconcile startup recipes in place
         if (appliedStackableDiscounts == null || appliedStackableDiscounts != stackableDiscounts) {
             net.minecraft.world.entity.ai.gossip.GossipType.MINOR_POSITIVE.max = stackableDiscounts ? 200 : 25;
             net.minecraft.world.entity.ai.gossip.GossipType.MAJOR_POSITIVE.max = stackableDiscounts ? 100 : 20;
@@ -1822,16 +1822,22 @@ public class GeneralCompatConfig {
         if (!fun.bm.lophine.carpet.CarpetRuleChanges.isChanging()) CarpetProtocalDataBase.apply();
     }
 
-    static void refreshRecipeRules() {
+    // Lecithin start - reconcile startup recipes in place before plugins register their recipes
+    static void applyRecipeRules(net.minecraft.server.MinecraftServer server) {
         List<Boolean> recipes = recipeRuleValues();
         List<Boolean> previous = appliedRecipeRules;
+        if (recipes.equals(previous)) {
+            return;
+        }
         appliedRecipeRules = recipes;
-        // Initial recipes are loaded during startup; only later rule changes need a resource reload.
-        if (previous != null && !recipes.equals(previous)) {
-            net.minecraft.server.MinecraftServer server = net.minecraft.server.MinecraftServer.getServer();
-            if (server != null && server.isRunning()) {
-                carpet.script.external.ScarpetNativeWork.record(fun.bm.lophine.carpet.ams.AmsRecipeLifecycle.changed(server));
-            }
+        if (server == null || !server.isRunning()) {
+            return;
+        }
+        if (previous == null) {
+            server.getRecipeManager().carpetReloadCompatRecipes();
+        } else {
+            carpet.script.external.ScarpetNativeWork.record(fun.bm.lophine.carpet.ams.AmsRecipeLifecycle.changed(server));
         }
     }
+    // Lecithin end - reconcile startup recipes in place before plugins register their recipes
 }
