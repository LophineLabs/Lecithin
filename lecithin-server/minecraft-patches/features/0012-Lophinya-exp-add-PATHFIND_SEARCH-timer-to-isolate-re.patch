From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Thu, 6 Aug 2026 00:58:33 +0800
Subject: [PATCH] Lophinya: exp - add PATHFIND_SEARCH timer to isolate real A*
 cost from Navigation Tick

Region-Bound NyaCore candidate C (async pathfinding offload) needs a real
per-call findPath() cost number before deciding if it clears the worker-pool
submission overhead that killed the Sensor-granularity candidate. Wraps only
the actual PathFinder#findPath invocation in PathNavigation#createPath,
diagnostic-only, exp/* branch.

diff --git a/ca/spottedleaf/leafprofiler/LProfilerRegistry.java b/ca/spottedleaf/leafprofiler/LProfilerRegistry.java
index 934ca6705739a42b8caddc12cea77db5cb03fe0f..06f7d339fec42e9bb945ff6bf1806dcd231b06cb 100644
--- a/ca/spottedleaf/leafprofiler/LProfilerRegistry.java
+++ b/ca/spottedleaf/leafprofiler/LProfilerRegistry.java
@@ -56,6 +56,13 @@ public final class LProfilerRegistry {
     public static final int BRAIN_BEHAVIOR_TICK = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Brain Behavior Tick");
     // Lophinya end - region parallel tick research
 
+    // Lophinya start - region parallel tick research: isolate real A* search cost from NAVIGATION_TICK
+    // (NAVIGATION_TICK wraps the whole per-tick navigation update, most of which is just following
+    // an already-computed path; PATHFIND_SEARCH wraps only actual PathFinder#findPath invocations,
+    // see project-docs/evidence/20260805-region-parallel-phase-framework-design.md candidate C)
+    public static final int PATHFIND_SEARCH = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Pathfind Search");
+    // Lophinya end - region parallel tick research
+
     // Lophinya start - region parallel phase framework (DEC-69), see fun.bm.lophinya.parallel
     public static final int REGION_PARALLEL_SHADOW_RUN = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Region Parallel Shadow Run");
     public static final int REGION_PARALLEL_SUBMITTED = GLOBAL_REGISTRY.createType(ProfileType.COUNTER, "Region Parallel Submitted");
diff --git a/net/minecraft/world/entity/ai/navigation/PathNavigation.java b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
index 4c727e4f224f6a31a4cd9d024bdcfaf0fa1bc0e5..65f3f239a230f95a8082ecac1a05615f6af89b91 100644
--- a/net/minecraft/world/entity/ai/navigation/PathNavigation.java
+++ b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
@@ -205,7 +205,13 @@ public abstract class PathNavigation {
         BlockPos fromPos = above ? this.mob.blockPosition().above() : this.mob.blockPosition();
         int radius = (int)(maxPathLength + radiusOffset);
         PathNavigationRegion region = new PathNavigationRegion(this.level, fromPos.offset(-radius, -radius, -radius), fromPos.offset(radius, radius, radius));
+        // Lophinya start - region parallel tick research: isolate real A* search cost (exp/*, diagnostic only)
+        // see project-docs/evidence/20260805-region-parallel-phase-framework-design.md candidate C
+        final ca.spottedleaf.leafprofiler.RegionizedProfiler.Handle lophinyaProfiler = io.papermc.paper.threadedregions.TickRegionScheduler.getProfiler();
+        lophinyaProfiler.startTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.PATHFIND_SEARCH);
         Path path = this.pathFinder.findPath(region, this.mob, targets, maxPathLength, reachRange, this.maxVisitedNodesMultiplier);
+        lophinyaProfiler.stopTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.PATHFIND_SEARCH);
+        // Lophinya end - region parallel tick research
         profiler.pop();
         if (path != null && path.getTarget() != null) {
             this.targetPos = path.getTarget();
