     }
 
     public Entity getCamera() {
+        if (fun.bm.lecithin.compat.legacy.LegacyOwnerOperations.needed(this)) {
+            return fun.bm.lecithin.compat.legacy.LegacyOwnerOperations.entity(this,this::getCamera);
+        }
         return this.camera == null ? this : this.camera;
     }
 
