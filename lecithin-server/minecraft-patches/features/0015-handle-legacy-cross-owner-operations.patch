     public void run() { // Luminol - Level hot unload apis - Make public
+        fun.bm.lecithin.compat.legacy.LegacyOwnerOperations.beginShutdown();
         // await scheduler termination
         LOGGER.info("Awaiting scheduler termination for 60s...");
         if (TickRegions.getScheduler().halt(true, TimeUnit.SECONDS.toNanos(60L))) {
@@ -160,6 +161,7 @@ public class RegionShutdownThread extends ca.spottedleaf.moonrise.common.util.Ti
             TickRegions.getScheduler().dumpAliveThreadTraces("Did not shut down in time");
         }
 
+        TickRegionScheduler.awaitLegacyOwnerOperations();
