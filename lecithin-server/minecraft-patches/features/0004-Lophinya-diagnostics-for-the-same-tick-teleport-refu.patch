From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Fri, 31 Jul 2026 20:06:13 +0800
Subject: [PATCH] Lophinya: diagnostics for the same-tick teleport refusal
 (D-40)

The hook half of paper-patch 0036. Two calls, both guarded by the diagnostic's
own default-off switch and both output-only: one at the canTeleportAsync()
refusal in teleportAsync, one at setLevelCallback before the assignment.

See LophinyaTeleportRefusalDiagnostics.

Switch: -Dlophinya.compat.teleportRefusalDiagnostics=true

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>

diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index cc145ef1bd8061c8fb897333d0927c8e50066700..81dde58eb456b7fb449aa95209923778decbaa01 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -4551,6 +4551,13 @@ public abstract class Entity
         }
 
         if (!this.canTeleportAsync()) {
+            // Lophinya - D-40 diagnostics: this return is the silent second teleport. Print which of
+            // canTeleportAsync()'s four predicates said no, rather than guessing from outside again.
+            // Off by default; cannot affect the refusal, which has already been decided.
+            if (fun.bm.lophinya.compat.LophinyaTeleportRefusalDiagnostics.ENABLED) {
+                fun.bm.lophinya.compat.LophinyaTeleportRefusalDiagnostics.reportRefusal(this, destination, pos);
+            }
+            // Lophinya end
             return false;
         }
         this.getBukkitEntity(); // force bukkit entity to be created before TPing
@@ -6405,6 +6412,13 @@ public abstract class Entity
 
     @Override
     public void setLevelCallback(final EntityInLevelCallback levelCallback) {
+        // Lophinya - D-40 diagnostics: record when the entity leaves and rejoins the level lookup.
+        // Off by default, prints only on a NULL <-> set transition, and cannot alter the assignment
+        // below. See LophinyaTeleportRefusalDiagnostics.
+        if (fun.bm.lophinya.compat.LophinyaTeleportRefusalDiagnostics.ENABLED) {
+            fun.bm.lophinya.compat.LophinyaTeleportRefusalDiagnostics.reportCallbackTransition(this, this.levelCallback, levelCallback);
+        }
+        // Lophinya end
         this.levelCallback = levelCallback;
     }
 
