From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Mon, 3 Aug 2026 16:28:37 +0800
Subject: [PATCH] restore MinecraftServer.currentTick with global-region
 semantics

Folia commented the field out; FastAsyncWorldEdit reads it reflectively
in its NMS adapter (PaperweightFaweWorldNativeAccess) and every WorldEdit
command dies on NoSuchFieldError without it. Paper advanced the counter
once per main-thread tick; the global region tick is that loop's
successor here, so it is the single writer. volatile for the
cross-thread readers the old plain int already had in practice.

diff --git a/io/papermc/paper/threadedregions/RegionizedServer.java b/io/papermc/paper/threadedregions/RegionizedServer.java
index ee1c37a91f60a6e5401d2ebf0289667ba733f1a1..a65ad3391f26b622c27dba9066f0b35cecd63773 100644
--- a/io/papermc/paper/threadedregions/RegionizedServer.java
+++ b/io/papermc/paper/threadedregions/RegionizedServer.java
@@ -237,12 +237,14 @@ public final class RegionizedServer {
     private long lastServerStatus;
     private long tickCount;
 
+    // Lecithin - restore MinecraftServer.currentTick; kill switch freezes it at 0 (the field
     private void globalTick(final long tickCount) {
         fun.bm.lophine.carpet.CarpetProfileService.startGlobalTick();
         var carpetProfileTick = fun.bm.lophine.carpet.CarpetProfileObserver.global("Full Tick");
         try {
         final long tickStartNanos = System.nanoTime(); // Lophine - Carpet features
         ++this.tickCount;
+        if (fun.bm.lecithin.config.modules.CompatConfig.serverCurrentTick) MinecraftServer.currentTick = (int) this.tickCount; // Lecithin - restore currentTick, single writer is this global tick
         fun.bm.lophine.protocol.CarpetLoggerProtocol.onGlobalTick(this.tickCount);
         // Luminol start - Add a config to enable tick command
         if (fun.bm.lophine.carpet.config.modules.GeneralCompatConfig.tickCommandEnabled()) { // Lophine - redirect
diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index ccb89748cddd5baf52192e553699afa0a5970472..e734794aa8f7bd6d62a6a7c030b281e7acf3cf07 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -314,7 +314,13 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     public org.bukkit.craftbukkit.CraftServer server;
     public joptsimple.OptionSet options;
     public org.bukkit.command.ConsoleCommandSender console;
-    //public static int currentTick; // Paper - improve tick loop // Folia - region threading
+    // Lecithin start - restore currentTick with global-region semantics
+    // Paper's counter advanced once per main-thread tick and is part of the de-facto plugin
+    // surface: FastAsyncWorldEdit reads it reflectively and its NMS adapter dies on
+    // NoSuchFieldError without it. The global region tick is that loop's successor on this fork
+    // (see RegionizedServer.globalTick, the single writer). volatile: cross-thread readers.
+    public static volatile int currentTick; // Paper - improve tick loop // Folia - region threading
+    // Lecithin end
     public java.util.Queue<Runnable> processQueue = new java.util.concurrent.ConcurrentLinkedQueue<Runnable>();
     public int autosavePeriod;
     // Paper - don't store the vanilla dispatcher
