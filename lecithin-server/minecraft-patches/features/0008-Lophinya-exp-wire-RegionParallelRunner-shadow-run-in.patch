From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Wed, 5 Aug 2026 22:47:22 +0800
Subject: [PATCH] Lophinya: exp - wire RegionParallelRunner shadow-run into
 Brain.tick

First real call site for the Region-local parallel phase framework
(fun.bm.lophinya.parallel, DEC-69). Adds LProfilerRegistry counters/timer for
it and calls RegionParallelRunner.runPhase with the no-op SensorShadowPhase for
the single entity Brain.tick() is already processing.

Default off (RegionParallelConfig.SENSOR_SHADOW_ENABLED). Purpose is to measure
the framework's own submit/barrier/commit-validate overhead in isolation before
any real phase is attached - not yet batching multiple entities, which is the
next step (see project-docs/evidence/20260805-region-parallel-phase-framework-
design.md 4). Behaviour-identical when on: every SensorShadowPhase method is a
no-op.

exp/* isolated exploration branch. Not for merge into ver/26.2-nya.

diff --git a/ca/spottedleaf/leafprofiler/LProfilerRegistry.java b/ca/spottedleaf/leafprofiler/LProfilerRegistry.java
index b888cb608626d18bf64ff63daea327cf633e04aa..934ca6705739a42b8caddc12cea77db5cb03fe0f 100644
--- a/ca/spottedleaf/leafprofiler/LProfilerRegistry.java
+++ b/ca/spottedleaf/leafprofiler/LProfilerRegistry.java
@@ -55,4 +55,13 @@ public final class LProfilerRegistry {
     public static final int NAVIGATION_TICK = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Navigation Tick");
     public static final int BRAIN_BEHAVIOR_TICK = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Brain Behavior Tick");
     // Lophinya end - region parallel tick research
+
+    // Lophinya start - region parallel phase framework (DEC-69), see fun.bm.lophinya.parallel
+    public static final int REGION_PARALLEL_SHADOW_RUN = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Region Parallel Shadow Run");
+    public static final int REGION_PARALLEL_SUBMITTED = GLOBAL_REGISTRY.createType(ProfileType.COUNTER, "Region Parallel Submitted");
+    public static final int REGION_PARALLEL_QUEUE_FULL = GLOBAL_REGISTRY.createType(ProfileType.COUNTER, "Region Parallel Queue Full Fallback");
+    public static final int REGION_PARALLEL_TIMED_OUT = GLOBAL_REGISTRY.createType(ProfileType.COUNTER, "Region Parallel Timed Out");
+    public static final int REGION_PARALLEL_DISCARDED_STALE = GLOBAL_REGISTRY.createType(ProfileType.COUNTER, "Region Parallel Discarded Stale Result");
+    public static final int REGION_PARALLEL_COMMITTED = GLOBAL_REGISTRY.createType(ProfileType.COUNTER, "Region Parallel Committed");
+    // Lophinya end - region parallel phase framework
 }
diff --git a/net/minecraft/world/entity/ai/Brain.java b/net/minecraft/world/entity/ai/Brain.java
index 5cad1ee03cc19533ff1b722b5e438d528920b2c9..fcb84de19552e1140ecd09bc181a2ea96a418cb0 100644
--- a/net/minecraft/world/entity/ai/Brain.java
+++ b/net/minecraft/world/entity/ai/Brain.java
@@ -394,6 +394,27 @@ public class Brain<E extends LivingEntity> {
         this.tickEachRunningBehavior(level, body);
         lophinyaProfiler.stopTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.BRAIN_BEHAVIOR_TICK);
         // Lophinya end - region parallel tick research
+
+        // Lophinya start - region parallel phase framework (DEC-69), first wired call site
+        // Default off (RegionParallelConfig.SENSOR_SHADOW_ENABLED). Runs a no-op phase through the
+        // real submit/barrier/commit-validate pipeline for this one entity so its overhead is
+        // measurable on its own before any real phase (Sensor, Goal, Navigation, Brain behavior) is
+        // attached. This does not batch multiple entities together yet - see
+        // project-docs/evidence/20260805-region-parallel-phase-framework-design.md 4 for why that is
+        // the next step, not this one. Changes nothing: SensorShadowPhase's three methods are no-ops.
+        if (fun.bm.lophinya.parallel.RegionParallelConfig.SENSOR_SHADOW_ENABLED) {
+            lophinyaProfiler.startTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.REGION_PARALLEL_SHADOW_RUN);
+            final fun.bm.lophinya.parallel.RegionParallelRunner.Stats stats =
+                fun.bm.lophinya.parallel.RegionParallelRunner.runPhase(
+                    level, java.util.List.of(body), fun.bm.lophinya.parallel.SensorShadowPhase.INSTANCE);
+            lophinyaProfiler.stopTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.REGION_PARALLEL_SHADOW_RUN);
+            lophinyaProfiler.addCounter(ca.spottedleaf.leafprofiler.LProfilerRegistry.REGION_PARALLEL_SUBMITTED, stats.submitted);
+            lophinyaProfiler.addCounter(ca.spottedleaf.leafprofiler.LProfilerRegistry.REGION_PARALLEL_QUEUE_FULL, stats.rejectedQueueFull);
+            lophinyaProfiler.addCounter(ca.spottedleaf.leafprofiler.LProfilerRegistry.REGION_PARALLEL_TIMED_OUT, stats.timedOut);
+            lophinyaProfiler.addCounter(ca.spottedleaf.leafprofiler.LProfilerRegistry.REGION_PARALLEL_DISCARDED_STALE, stats.discardedInvalid + stats.discardedNotOwned);
+            lophinyaProfiler.addCounter(ca.spottedleaf.leafprofiler.LProfilerRegistry.REGION_PARALLEL_COMMITTED, stats.committed);
+        }
+        // Lophinya end - region parallel phase framework
     }
 
     private void tickSensors(final ServerLevel level, final E body) {
