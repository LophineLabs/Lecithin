From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Fri, 7 Aug 2026 00:39:48 +0800
Subject: [PATCH] Lophinya: exp - candidate C: wire MoveToTargetSink into
 RegionParallelRunner

First real villager Brain/Navigation call site for NyaCore candidate C
(DEC-70 3, wiring phase). MoveToTargetSink.tryComputePath is the single
generic WALK_TARGET consumer behind nearly all villager locomotion (wander,
walk-to-trade, walk-to-workstation-restock, walk-to-bed) - both of its
PathNavigation#createPath call sites now branch on
RegionParallelConfig.NAVIGATION_ENABLED: off keeps the exact vanilla
synchronous call unchanged, on routes through
NavigationPathfindPhase#computeViaFramework (same radiusOffset=8/above=false/
reachRange as the vanilla calls being replaced) with the real
RegionParallelRunner queue/deadline/commit-validate pipeline behind it.
Fully behavior-reversible via the flag.

Known limitation: one mob per runPhase call here, not batched with other
mobs requesting a path the same tick - does not reproduce the
n=100/300/1000 matrix's batched-dispatch performance win. Real batching
would need an entity-tick-loop restructure (collect-then-dispatch), out of
scope for this wiring pass. See
project-docs/evidence/20260807-nyacore-candidate-c-navigation-wiring.md.

exp/* isolated exploration, not for merge into ver/26.2-nya.

diff --git a/net/minecraft/world/entity/ai/behavior/MoveToTargetSink.java b/net/minecraft/world/entity/ai/behavior/MoveToTargetSink.java
index ffb8a725c41d49a0f0e023ab37bb77062d67eccc..d63c34ea9ed44e52c76e9df7d22ded183f3a3d9c 100644
--- a/net/minecraft/world/entity/ai/behavior/MoveToTargetSink.java
+++ b/net/minecraft/world/entity/ai/behavior/MoveToTargetSink.java
@@ -118,7 +118,16 @@ public class MoveToTargetSink extends Behavior<Mob> {
     private boolean tryComputePath(final Mob body, final WalkTarget walkTarget, final long timestamp) {
         BlockPos targetPos = walkTarget.getTarget().currentBlockPosition();
         if (ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(body.level(), targetPos)) // Kaiiju - Don't pathfind outside region
-        this.path = body.getNavigation().createPath(targetPos, 0);
+        // Lophinya start - candidate C wiring (DEC-70), default off (RegionParallelConfig.NAVIGATION_ENABLED).
+        // Same radiusOffset=8/above=false/reachRange as the vanilla call this replaces - see
+        // PathNavigation#createPath(BlockPos, int) -> createPath(Set.of(pos), 8, false, reachRange).
+        if (fun.bm.lophinya.parallel.RegionParallelConfig.NAVIGATION_ENABLED) {
+            this.path = fun.bm.lophinya.parallel.nyacore.NavigationPathfindPhase.computeViaFramework(
+                (net.minecraft.server.level.ServerLevel) body.level(), body, java.util.Set.of(targetPos), 8, false, 0, 1.0F);
+        } else {
+            this.path = body.getNavigation().createPath(targetPos, 0);
+        }
+        // Lophinya end - candidate C wiring
         else this.path = null; // Kaiiju - Don't pathfind outside region
         this.speedModifier = walkTarget.getSpeedModifier();
         Brain<?> brain = body.getBrain();
@@ -138,7 +147,15 @@ public class MoveToTargetSink extends Behavior<Mob> {
 
             Vec3 partialStep = DefaultRandomPos.getPosTowards((PathfinderMob)body, 10, 7, Vec3.atBottomCenterOf(targetPos), (float) (Math.PI / 2));
             if (partialStep != null) {
-                this.path = body.getNavigation().createPath(partialStep.x, partialStep.y, partialStep.z, 0);
+                // Lophinya start - candidate C wiring (DEC-70), same flag/parity as the primary call above
+                if (fun.bm.lophinya.parallel.RegionParallelConfig.NAVIGATION_ENABLED) {
+                    net.minecraft.core.BlockPos partialPos = net.minecraft.core.BlockPos.containing(partialStep.x, partialStep.y, partialStep.z);
+                    this.path = fun.bm.lophinya.parallel.nyacore.NavigationPathfindPhase.computeViaFramework(
+                        (net.minecraft.server.level.ServerLevel) body.level(), body, java.util.Set.of(partialPos), 8, false, 0, 1.0F);
+                } else {
+                    this.path = body.getNavigation().createPath(partialStep.x, partialStep.y, partialStep.z, 0);
+                }
+                // Lophinya end - candidate C wiring
                 return this.path != null;
             }
         }
