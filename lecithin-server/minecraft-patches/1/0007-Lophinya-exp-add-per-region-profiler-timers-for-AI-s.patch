From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Wed, 5 Aug 2026 21:54:56 +0800
Subject: [PATCH] Lophinya: exp - add per-region profiler timers for AI
 sub-phases

Diagnostic-only, exp/* isolated exploration branch. Adds MOB_SENSING_TICK,
BRAIN_SENSOR_TICK, GOAL_SELECTOR_TICK, NAVIGATION_TICK, BRAIN_BEHAVIOR_TICK
to LProfilerRegistry and wraps the corresponding call sites in Mob.serverAiStep()
and Brain.tick() with the existing RegionizedProfiler.Handle, following the same
pattern already used for ENTITY_TRACKER_TICK / POI_MANAGER_TICK.

No behavior change: Handle.startTimer/stopTimer are no-ops unless a /profiler
run is active on that region (see RegionizedProfiler.Handle.noOp). Purpose is
to let the existing /profiler command break down what is currently folded into
the generic ENTITY_TICK timer, per DEC-69 (Region internal parallelization
research, reactivated 2026-08-05).

Not for merge into ver/26.2-nya delivery branch. See
project-docs/evidence/20260805-region-parallel-tick-topology.md.

diff --git a/ca/spottedleaf/leafprofiler/LProfilerRegistry.java b/ca/spottedleaf/leafprofiler/LProfilerRegistry.java
index a000e8a944ce1c4648e783d45dbd121a977acc43..b888cb608626d18bf64ff63daea327cf633e04aa 100644
--- a/ca/spottedleaf/leafprofiler/LProfilerRegistry.java
+++ b/ca/spottedleaf/leafprofiler/LProfilerRegistry.java
@@ -46,4 +46,13 @@ public final class LProfilerRegistry {
     public static final int TILE_ENTITY_PENDING = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Tile Entity Handle Pending");
     public static final int TILE_ENTITY_TICK = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Tile Entity Tick");
     public static final int PASSENGER_DESYNC_CHECK = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Check Passenger Desync"); // Folia - fix passenger desync
+
+    // Lophinya start - region parallel tick research: sub-phase timers folded into ENTITY_TICK
+    // exp/* diagnostic only, see project-docs/evidence/20260805-region-parallel-tick-topology.md
+    public static final int MOB_SENSING_TICK = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Mob Sensing Tick");
+    public static final int BRAIN_SENSOR_TICK = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Brain Sensor Tick");
+    public static final int GOAL_SELECTOR_TICK = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Goal/Target Selector Tick");
+    public static final int NAVIGATION_TICK = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Navigation Tick");
+    public static final int BRAIN_BEHAVIOR_TICK = GLOBAL_REGISTRY.createType(ProfileType.TIMER, "Brain Behavior Tick");
+    // Lophinya end - region parallel tick research
 }
diff --git a/net/minecraft/world/entity/Mob.java b/net/minecraft/world/entity/Mob.java
index f3813df2734c9bc1fcecb317b8450ff13b9706dd..1d03908dc535f3ce5944eda182dde63b145fc444 100644
--- a/net/minecraft/world/entity/Mob.java
+++ b/net/minecraft/world/entity/Mob.java
@@ -882,10 +882,15 @@ public abstract class Mob extends LivingEntity implements Targeting, EquipmentUs
         // Paper end - Allow nerfed mobs to jump and float
         int idBasedTickCount = this.tickCount + this.getId(); // Luminol - Petal - Move up
         ProfilerFiller profiler = Profiler.get();
+        // Lophinya start - region parallel tick research: per-region sub-phase timers (exp/*, diagnostic only)
+        final ca.spottedleaf.leafprofiler.RegionizedProfiler.Handle lophinyaProfiler = io.papermc.paper.threadedregions.TickRegionScheduler.getProfiler();
         profiler.push("sensing");
+        lophinyaProfiler.startTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.MOB_SENSING_TICK);
         if (idBasedTickCount % me.earthme.luminol.config.modules.optimizations.PetalReduceSensorWorkConfig.delayTicks == 0 || !me.earthme.luminol.config.modules.optimizations.PetalReduceSensorWorkConfig.enabled) this.sensing.tick(); // Luminol - Petal - Reduce sensor work
+        lophinyaProfiler.stopTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.MOB_SENSING_TICK);
         profiler.pop();
         //int idBasedTickCount = this.tickCount + this.getId(); // Luminol - Petal - Move up
+        lophinyaProfiler.startTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.GOAL_SELECTOR_TICK);
         if (idBasedTickCount % 2 != 0 && this.tickCount > 1) {
             profiler.push("targetSelector");
             this.targetSelector.tickRunningGoals(false);
@@ -901,10 +906,14 @@ public abstract class Mob extends LivingEntity implements Targeting, EquipmentUs
             this.goalSelector.tick();
             profiler.pop();
         }
+        lophinyaProfiler.stopTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.GOAL_SELECTOR_TICK);
 
         profiler.push("navigation");
+        lophinyaProfiler.startTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.NAVIGATION_TICK);
         this.navigation.tick();
+        lophinyaProfiler.stopTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.NAVIGATION_TICK);
         profiler.pop();
+        // Lophinya end - region parallel tick research
         profiler.push("mob tick");
         this.customServerAiStep((ServerLevel)this.level());
         profiler.pop();
diff --git a/net/minecraft/world/entity/ai/Brain.java b/net/minecraft/world/entity/ai/Brain.java
index 71a11238835b1090c283d03cc30e09b8a65a9762..5cad1ee03cc19533ff1b722b5e438d528920b2c9 100644
--- a/net/minecraft/world/entity/ai/Brain.java
+++ b/net/minecraft/world/entity/ai/Brain.java
@@ -383,10 +383,17 @@ public class Brain<E extends LivingEntity> {
     }
 
     public void tick(final ServerLevel level, final E body) {
+        // Lophinya start - region parallel tick research: per-region sub-phase timers (exp/*, diagnostic only)
+        final ca.spottedleaf.leafprofiler.RegionizedProfiler.Handle lophinyaProfiler = io.papermc.paper.threadedregions.TickRegionScheduler.getProfiler();
         this.forgetOutdatedMemories(body); // Luminol - Add config to force clean entity memory that don't belong to current tick region
+        lophinyaProfiler.startTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.BRAIN_SENSOR_TICK);
         this.tickSensors(level, body);
+        lophinyaProfiler.stopTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.BRAIN_SENSOR_TICK);
+        lophinyaProfiler.startTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.BRAIN_BEHAVIOR_TICK);
         this.startEachNonRunningBehavior(level, body);
         this.tickEachRunningBehavior(level, body);
+        lophinyaProfiler.stopTimer(ca.spottedleaf.leafprofiler.LProfilerRegistry.BRAIN_BEHAVIOR_TICK);
+        // Lophinya end - region parallel tick research
     }
 
     private void tickSensors(final ServerLevel level, final E body) {
