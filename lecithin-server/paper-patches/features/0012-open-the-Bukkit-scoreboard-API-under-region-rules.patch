+        if (!fun.bm.lecithin.config.modules.CompatConfig.scoreboardApi) throw new UnsupportedOperationException(); // Folia - not supported yet
+        if (fun.bm.lecithin.compat.LecithinScoreboardSupport.isMainBoard(this.board)) {
