@@ -2419,7 +2419,8 @@ public final class CraftServer implements Server {
 
     @Override
     public boolean isPrimaryThread() {
-        return ca.spottedleaf.moonrise.common.util.TickThread.isTickThread(); // Paper - rewrite chunk system
+        return ca.spottedleaf.moonrise.common.util.TickThread.isTickThread() // Paper - rewrite chunk system
+            || fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.isLegacyLane(); // Lecithin - Legacy Paper Runtime: the lane is a managed plugin's main thread; ownership checks are unaffected
     }
 
     @Override
diff --git a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
index 954ab2b7e6812d5043bfccc801306bbcbf31688d..120025b1a8258f44d312f5152bf4a3d3d1de9bf1 100644
--- a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
+++ b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
@@ -426,7 +426,8 @@ public class CraftScheduler implements BukkitScheduler {
             }
         }
         CraftTask task = this.runners.get(taskId);
-        return task != null && task.getPeriod() >= CraftTask.NO_REPEATING;
+        // Lecithin - a redispatched or managed legacy task lives in none of the queues above
+        return (task != null && task.getPeriod() >= CraftTask.NO_REPEATING) || fun.bm.lecithin.compat.LecithinDispatchedTasks.isTracked(taskId);
     }
 
     @Override
@@ -572,6 +573,14 @@ public class CraftScheduler implements BukkitScheduler {
         // still falls through to the throw below, whenever nothing is known - which is the fail-closed
         // case and stays that way.
         if (!this.isAsyncScheduler && task.isSync()) {
+            // Lecithin start - Legacy Paper Runtime: a plugin that never declared Folia support gets
+            // the managed legacy scheduler (global-clock timing, plugin domain, owner or lane
+            // execution). A native plugin falls through to caller-context dispatch unchanged.
+            final CraftTask managed = fun.bm.lecithin.compat.legacy.LegacyScheduler.tryRoute(task, delay, task.getPeriod());
+            if (managed != null) {
+                return managed;
+            }
+            // Lecithin end - Legacy Paper Runtime
             final CraftTask redispatched = fun.bm.lecithin.compat.LecithinCallerContextDispatch.tryDispatch(task, delay, task.getPeriod());
             if (redispatched != null) {
                 return redispatched;
diff --git a/src/test/java/fun/bm/lecithin/compat/legacy/LegacyExecutionDomainTestSuite.java b/src/test/java/fun/bm/lecithin/compat/legacy/LegacyExecutionDomainTestSuite.java
new file mode 100644
index 0000000000000000000000000000000000000000..6b7a7f6a9ea47789605f4211ce046f5f39ebc9f2
--- /dev/null
+++ b/src/test/java/fun/bm/lecithin/compat/legacy/LegacyExecutionDomainTestSuite.java
@@ -0,0 +1,149 @@
+package fun.bm.lecithin.compat.legacy;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.Timeout;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.CyclicBarrier;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Lecithin: the serial legacy domain - one thread inside at a time, re-entrant, and a two-plugin
+ * call cycle across two threads completes instead of deadlocking.
+ */
+class LegacyExecutionDomainTestSuite {
+
+    /**
+     * A plain field updated with a read-modify-write, the shape of every unsynchronised plugin map.
+     */
+    private int unsafeCounter;
+
+    @Test
+    @Timeout(30)
+    void onlyOneThreadIsInsideAtATime() throws Exception {
+        final LegacyExecutionDomain domain = new LegacyExecutionDomain("serial");
+        final int threads = 8;
+        final int rounds = 20_000;
+        final AtomicInteger inside = new AtomicInteger();
+        final AtomicReference<String> overlap = new AtomicReference<>();
+        final CyclicBarrier start = new CyclicBarrier(threads);
+        final List<Thread> workers = new ArrayList<>();
+        this.unsafeCounter = 0;
+        for (int t = 0; t < threads; t++) {
+            final Thread worker = new Thread(() -> {
+                try {
+                    start.await();
+                } catch (final Exception e) {
+                    throw new RuntimeException(e);
+                }
+                for (int i = 0; i < rounds; i++) {
+                    domain.enter();
+                    try {
+                        if (inside.incrementAndGet() != 1) {
+                            overlap.compareAndSet(null, Thread.currentThread().getName());
+                        }
+                        this.unsafeCounter = this.unsafeCounter + 1;
+                        inside.decrementAndGet();
+                    } finally {
+                        domain.exit();
+                    }
+                }
+            }, "domain-worker-" + t);
+            workers.add(worker);
+            worker.start();
+        }
+        for (final Thread worker : workers) {
+            worker.join();
+        }
+        assertNull(overlap.get(), "two threads were inside the domain at once");
+        // Exact: every hand-over is a release/acquire, so no increment is lost or stale.
+        assertEquals(threads * rounds, this.unsafeCounter);
+        assertTrue(domain.contended.sum() > 0, "the test never actually contended");
+    }
+
+    @Test
+    @Timeout(10)
+    void reentryOnTheOwningThreadDoesNotBlock() {
+        final LegacyExecutionDomain domain = new LegacyExecutionDomain("reentrant");
+        domain.enter();
+        domain.enter();
+        assertTrue(domain.isHeldByCurrentThread());
+        domain.exit();
+        assertTrue(domain.isHeldByCurrentThread());
+        domain.exit();
+        assertFalse(domain.isHeldByCurrentThread());
+    }
+
+    /**
+     * Thread A is inside plugin X and calls into plugin Y; at the same moment thread B is inside Y and
+     * calls into X. A lock per plugin deadlocks here. On Paper this is one thread re-entering, and the
+     * domain lets the thread that closes the cycle proceed as that re-entry while the other is parked.
+     */
+    @Test
+    @Timeout(20)
+    void crossPluginCycleCompletesAndNeverOverlaps() throws Exception {
+        final LegacyExecutionDomain x = new LegacyExecutionDomain("X");
+        final LegacyExecutionDomain y = new LegacyExecutionDomain("Y");
+        final CountDownLatch bothInside = new CountDownLatch(2);
+        final AtomicInteger insideX = new AtomicInteger();
+        final AtomicInteger insideY = new AtomicInteger();
+        final AtomicReference<String> overlap = new AtomicReference<>();
+        final AtomicInteger finished = new AtomicInteger();
+
+        final Thread a = new Thread(() -> callInto(x, y, insideX, insideY, bothInside, overlap, finished), "A");
+        final Thread b = new Thread(() -> callInto(y, x, insideY, insideX, bothInside, overlap, finished), "B");
+        a.start();
+        b.start();
+        a.join(TimeUnit.SECONDS.toMillis(15));
+        b.join(TimeUnit.SECONDS.toMillis(15));
+
+        assertFalse(a.isAlive() || b.isAlive(), "cross-plugin call cycle deadlocked");
+        assertEquals(2, finished.get());
+        assertNull(overlap.get(), "two running threads were inside one domain at once");
+        assertEquals(1, x.borrows.sum() + y.borrows.sum(), "exactly one thread should have closed the cycle");
+        assertFalse(x.isHeldByCurrentThread() || y.isHeldByCurrentThread());
+    }
+
+    private static void callInto(final LegacyExecutionDomain outer, final LegacyExecutionDomain inner,
+                                 final AtomicInteger insideOuter, final AtomicInteger insideInner,
+                                 final CountDownLatch bothInside, final AtomicReference<String> overlap,
+                                 final AtomicInteger finished) {
+        outer.enter();
+        try {
+            insideOuter.incrementAndGet();
+            bothInside.countDown();
+            try {
+                // Force the interleaving: both threads hold their outer domain before either calls out.
+                bothInside.await(5, TimeUnit.SECONDS);
+            } catch (final InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+            // Calling out: this frame of the outer plugin is suspended until the callee returns, as
+            // on Paper. Only now may another thread re-enter it.
+            insideOuter.decrementAndGet();
+            inner.enter();
+            try {
+                if (insideInner.incrementAndGet() != 1) {
+                    overlap.compareAndSet(null, Thread.currentThread().getName());
+                }
+                insideInner.decrementAndGet();
+            } finally {
+                inner.exit();
+            }
+            insideOuter.incrementAndGet();
+            insideOuter.decrementAndGet();
+        } finally {
+            outer.exit();
+        }
+        finished.incrementAndGet();
+    }
+}
