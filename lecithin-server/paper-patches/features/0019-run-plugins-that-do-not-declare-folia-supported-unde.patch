@@ -201,7 +201,10 @@ class PaperPluginInstanceManager {
             fun.bm.lecithin.compat.LecithinPaperLibAdapter.install(jPlugin);
             // Lecithin end
 
+            final fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.Frame lecithin$frame =
+                fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.enterLifecycle(jPlugin); // Lecithin - Legacy Paper Runtime
             try {
+                fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.enabled(jPlugin); // Lecithin - Legacy Paper Runtime
                 jPlugin.setEnabled(true);
             } catch (Throwable ex) {
                 this.server.getLogger().log(Level.SEVERE, "Error occurred while enabling " + plugin.getPluginMeta().getDisplayName() + " (Is it up to date?)", ex);
@@ -209,6 +212,8 @@ class PaperPluginInstanceManager {
                 this.server.getPluginManager().disablePlugin(jPlugin);
                 return;
                 // Paper end
+            } finally {
+                fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.exit(lecithin$frame); // Lecithin - Legacy Paper Runtime
             }
 
             // Perhaps abort here, rather than continue going, but as it stands,
@@ -236,10 +241,15 @@ class PaperPluginInstanceManager {
             plugin.getLogger().info("Disabling %s".formatted(pluginName));
 
             this.server.getPluginManager().callEvent(new PluginDisableEvent(plugin));
+            // Lecithin - Legacy Paper Runtime: disabling waits for the plugin's running work, as Paper's single thread did
+            final fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.Frame lecithin$frame =
+                fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.enterLifecycle(javaPlugin);
             try {
                 javaPlugin.setEnabled(false);
             } catch (Throwable ex) {
                 this.server.getLogger().log(Level.SEVERE, "Error occurred while disabling " + pluginName, ex);
+            } finally {
+                fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.exit(lecithin$frame);
             }
 
             // Flush async appender before unloading, avoids issues when a log message with class context
@@ -285,6 +295,7 @@ class PaperPluginInstanceManager {
             fun.bm.lecithin.compat.LecithinDispatchedTasks.cancelAll(plugin);
         } catch (Throwable ignored) {
         }
+        fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.disabled(plugin); // Lecithin - Legacy Paper Runtime: close the lane, forget the instance
         // Lecithin end - cancel redispatched legacy sync tasks
 
         // Paper start - Folia schedulers
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 5295369735bbb7b4241fbb723ec5574e2353aaa1..2fa26a2447274258ebce50e11d6b8d4f761dbeec 100644
