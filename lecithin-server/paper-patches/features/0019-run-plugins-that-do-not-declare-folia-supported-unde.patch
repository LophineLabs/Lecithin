From: TinyYana <yanasakuranight@gmail.com>
Date: Fri, 25 Sep 2026 20:29:54 +0800
Subject: [PATCH] run plugins that do not declare folia-supported under a
 managed legacy runtime


diff --git a/src/main/java/io/papermc/paper/command/brigadier/bukkit/BukkitCommandNode.java b/src/main/java/io/papermc/paper/command/brigadier/bukkit/BukkitCommandNode.java
index 28fbdf2da69a1f97721a050980dc16160d566fa1..8ecba0fdccfe45d4b41690f6d0e05e518cdb9fc5 100644
--- a/src/main/java/io/papermc/paper/command/brigadier/bukkit/BukkitCommandNode.java
+++ b/src/main/java/io/papermc/paper/command/brigadier/bukkit/BukkitCommandNode.java
@@ -80,6 +80,12 @@ public class BukkitCommandNode extends LiteralCommandNode<CommandSourceStack> {
             String[] args = org.apache.commons.lang3.StringUtils.split(content, ' '); // fix adjacent spaces (from console/plugins) causing empty array elements
 
             // Note: we don't return the result of target.execute as thats success / failure, we return handled (true) or not handled (false)
+            // Lecithin start - Legacy Paper Runtime: a managed plugin's command runs inside its domain,
+            // which also subsumes the economy command lock (a managed provider is never guarded by it)
+            final fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.Frame lecithin$frame =
+                fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.enterCommand(this.command, sender);
+            try {
+            // Lecithin end - Legacy Paper Runtime
             // Lecithin start - economy serialization: this is the single choke point through which
             // every legacy (plugin.yml) Bukkit command is executed, so it is where the core can put
             // a guarded plugin's own economy commands under the same lock as its Vault provider.
@@ -98,6 +104,11 @@ public class BukkitCommandNode extends LiteralCommandNode<CommandSourceStack> {
 
             // return true as command was handled
             return 1;
+            // Lecithin start - Legacy Paper Runtime
+            } finally {
+                fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.exit(lecithin$frame);
+            }
+            // Lecithin end - Legacy Paper Runtime
         }
     }
 
@@ -119,11 +130,15 @@ public class BukkitCommandNode extends LiteralCommandNode<CommandSourceStack> {
 
             List<String> results = null;
             Location pos = context.getSource().getLocation();
+            final fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.Frame lecithin$frame =
+                fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.enterCommand(this.command, sender); // Lecithin - Legacy Paper Runtime
             try {
                 results = this.command.tabComplete(sender, this.literal, args, pos.clone());
             } catch (CommandException ex) {
                 sender.sendMessage(Component.text("An internal error occurred while attempting to tab-complete this command", NamedTextColor.RED));
                 Bukkit.getServer().getLogger().log(Level.SEVERE, "Exception when " + sender.getName() + " attempted to tab complete " + builder.getRemaining(), ex);
+            } finally {
+                fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.exit(lecithin$frame); // Lecithin - Legacy Paper Runtime
             }
 
             if (sender instanceof final Player player) {
diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
index 8316921c05f4bc791f5249df0e72dbb09f0cf5c4..b16ef38c33bae6c7ce54d99c1b76e5535c12ee2c 100644
