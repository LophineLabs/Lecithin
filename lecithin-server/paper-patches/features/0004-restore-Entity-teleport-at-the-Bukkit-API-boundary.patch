From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Thu, 30 Jul 2026 19:48:53 +0800
Subject: [PATCH] restore Entity#teleport at the Bukkit API boundary

Folia replaces CraftEntity/CraftPlayer teleport0 with an unconditional throw, so every Paper plugin that calls Entity#teleport(Location) is broken regardless of whether the move would be safe. Delegate to the platform's own teleportAsync and read the future without waiting: already-completed means Folia took its same-region fast path and did the move inline, so the real result is Paper's behaviour exactly; not-completed means the destination is another region/world and the teleport was accepted but has not happened yet, which is reported as true with a once-per-callsite diagnostic. No ownership check is bypassed and nothing is dispatched to the global scheduler.

diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index def7bf9d1b12decc62ae23f0b08dc1c13dddeac7..dec86d40a8f238aa3eae78fc460a3cfe7afff601 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -319,8 +319,13 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
 
     protected boolean teleport0(Location location, TeleportCause cause, TeleportFlag... flags) {
         // Folia start - region threading
+        // Lecithin start - restore Paper's Entity#teleport at the API boundary; see LecithinTeleportCompat
+        if (fun.bm.lecithin.config.modules.CompatConfig.teleportSemantics) {
+            return fun.bm.lecithin.compat.LecithinTeleportCompat.teleport(this, location, cause, flags);
+        }
+        // Lecithin end
         if (true) {
-            throw new UnsupportedOperationException("Must use teleportAsync while in region threading");
+            throw new UnsupportedOperationException(fun.bm.lecithin.compat.LecithinTeleportCompat.STOCK_MESSAGE); // Lecithin - same text, one definition
         }
         // Folia end - region threading
         Entity entity = this.getHandle();
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index 6a9ef066e002481a79500d92f8dc06e8a60f7502..116614718bb14382475f9182ba796eb7ed73d50f 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -1339,9 +1339,11 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
     @Override
     protected boolean teleport0(Location location, org.bukkit.event.player.PlayerTeleportEvent.TeleportCause cause, io.papermc.paper.entity.TeleportFlag... flags) {
         // Folia start - region threading
-        if (true) {
-            throw new UnsupportedOperationException("Must use teleportAsync while in region threading");
+        // Lecithin start - fall through to the checks below and then CraftEntity's shimmed teleport0
+        if (!fun.bm.lecithin.config.modules.CompatConfig.teleportSemantics) {
+            throw new UnsupportedOperationException(fun.bm.lecithin.compat.LecithinTeleportCompat.STOCK_MESSAGE);
         }
+        // Lecithin end
         // Folia end - region threading
         if (this.getHandle().connection == null) {
             return false;
