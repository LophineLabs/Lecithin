         if (this.level instanceof ServerLevel serverWorld) {
             // Lecithin start - serve a read-only lookup from a resident chunk instead of refusing it
@@ -210,6 +213,11 @@ public class CraftBlock implements Block {
     }
 
     public static boolean setBlockState(LevelAccessor level, BlockPos pos, net.minecraft.world.level.block.state.BlockState newState, boolean applyPhysics) {
+        if (level instanceof ServerLevel ownerWorld && fun.bm.lecithin.compat.legacy.LegacyOwnerOperations.needed(ownerWorld,pos.getX() >> 4,pos.getZ() >> 4)) {
+            final BlockPos immutable = pos.immutable();
+            return fun.bm.lecithin.compat.legacy.LegacyOwnerOperations.region(ownerWorld,pos.getX() >> 4,pos.getZ() >> 4,
+                () -> setBlockState(level,immutable,newState,applyPhysics));
+        }
         // Folia start - region threading
         if (level instanceof ServerLevel serverWorld) {
             ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(serverWorld, pos, "Cannot modify world asynchronously");
