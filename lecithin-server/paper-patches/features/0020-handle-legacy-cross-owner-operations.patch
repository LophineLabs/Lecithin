@@ -36,6 +36,7 @@ class PaperEventManager {
 
     // SimplePluginManager
     public void callEvent(@NotNull Event event) {
+        if (fun.bm.lecithin.compat.legacy.LegacyOwnerOperations.dispatchEvent(event, () -> this.callEvent(event))) return;
         // Leaves start - process bot load/save
         if (fun.bm.lophine.config.modules.function.FakeplayerConfig.checkEnabled() && fun.bm.lophine.carpet.config.modules.FakePlayerCompatConfig.fakePlayerResident) {
             if (event instanceof org.bukkit.event.world.WorldLoadEvent worldLoadEvent) {
@@ -90,12 +91,8 @@ class PaperEventManager {
                 continue;
             }
 
-            // Lecithin start - Legacy Paper Runtime: serial entry into a managed plugin
-            final fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.Frame lecithin$frame =
-                fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.enterListener(registration, event);
-            // Lecithin end - Legacy Paper Runtime
             try {
-                registration.callEvent(event);
+                fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.callListener(registration, event);
             } catch (AuthorNagException ex) {
                 Plugin plugin = registration.getPlugin();
 
@@ -115,8 +112,6 @@ class PaperEventManager {
                 if (!(event instanceof ServerExceptionEvent)) { // We don't want to cause an endless event loop
                     this.callEvent(new ServerExceptionEvent(new ServerEventException(msg, ex, registration.getPlugin(), registration.getListener(), event)));
                 }
-            } finally {
-                fun.bm.lecithin.compat.legacy.LegacyPluginRuntime.exit(lecithin$frame); // Lecithin - Legacy Paper Runtime
             }
         }
     }
