From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Wed, 5 Aug 2026 23:34:00 +0800
Subject: [PATCH] Lophinya: exp - chunk submission by worker count, not one
 task per entity

The batched shadow-run (previous commit, ServerLevel) still submitted one
pool task per entity - moving the collection point to ServerLevel only
changed *where* entities were gathered, not how many pool round trips
happened per tick. A/B measured that as a total-MSPT regression (4.5ms ->
8.5ms at 100 villagers, +88%): per-task submit/signal/get overhead dominates
when the work per task is tiny (a no-op, or a real Sensor tick averaging
~5 microseconds per entity per the profiler data).

runPhase now partitions entities into at most WORKERS contiguous chunks and
submits one task per chunk (each chunk's worker loops compute() over its
own slice). At most WORKERS pool round trips per region per tick, regardless
of entity count - this is the actual fix the earlier "batching" was meant to
be. Per-entity semantics (Stats counts, commit-time re-validation) unchanged.

exp/* isolated exploration branch per DEC-69. Not for merge into ver/26.2-nya.

diff --git a/src/main/java/fun/bm/lophinya/parallel/RegionParallelRunner.java b/src/main/java/fun/bm/lophinya/parallel/RegionParallelRunner.java
index f0a7af5a19bab3196e173f43cb681bc8f774777a..0b2d3672bab405448e8d340bfc9f40b53edd97d6 100644
--- a/src/main/java/fun/bm/lophinya/parallel/RegionParallelRunner.java
+++ b/src/main/java/fun/bm/lophinya/parallel/RegionParallelRunner.java
@@ -98,67 +98,94 @@ public final class RegionParallelRunner {
             snapshots[i] = phase.snapshot(level, entities.get(i));
         }
 
+        // Chunked submission, not one task per entity (2026-08-05 fix - see
+        // project-docs/evidence/20260805-region-parallel-phase-framework-design.md 8). The first
+        // batched version still submitted N tasks for N entities; it only moved *where* they were
+        // collected, not *how many round trips through the pool* happened, and measured a total-MSPT
+        // regression because per-task submit/signal/get overhead dwarfs a no-op compute() (and a real
+        // Sensor tick averages roughly 5 microseconds - see the same evidence doc). Splitting the
+        // batch into at most WORKERS chunks means at most WORKERS pool round trips per region per
+        // tick, regardless of how many entities are in it.
+        final int chunkCount = Math.max(1, Math.min(RegionParallelRunner.WORKERS, n));
+        final int chunkSize = (n + chunkCount - 1) / chunkCount;
+
         @SuppressWarnings("unchecked")
-        final Future<R>[] futures = new Future[n];
-        for (int i = 0; i < n; i++) {
-            final S snap = snapshots[i];
+        final Future<R[]>[] chunkFutures = new Future[chunkCount];
+        int chunkIndex = 0;
+        for (int start = 0; start < n; start += chunkSize, chunkIndex++) {
+            final int from = start;
+            final int to = Math.min(n, start + chunkSize);
             try {
-                futures[i] = POOL.submit(() -> phase.compute(snap));
-                stats.submitted++;
+                chunkFutures[chunkIndex] = POOL.submit(() -> computeChunk(phase, snapshots, from, to));
+                stats.submitted += to - from;
             } catch (final RejectedExecutionException poolFull) {
-                // Queue is full and every worker is busy: do not wait for room, compute right here
-                // on the calling thread instead. This is the "bounded queue, no unbounded backlog"
-                // requirement - a full queue degrades to synchronous, it never blocks.
-                futures[i] = CompletableFuture.completedFuture(phase.compute(snap));
-                stats.rejectedQueueFull++;
+                // Queue is full: do not wait for room, compute this chunk right here on the calling
+                // thread instead. Bounded queue, no unbounded backlog - a full queue degrades to
+                // synchronous, it never blocks.
+                chunkFutures[chunkIndex] = CompletableFuture.completedFuture(computeChunk(phase, snapshots, from, to));
+                stats.rejectedQueueFull += to - from;
             }
         }
 
         final long deadline = System.nanoTime() + RegionParallelConfig.DEADLINE_NANOS;
-        for (int i = 0; i < n; i++) {
-            final E entity = entities.get(i);
-            final Future<R> future = futures[i];
-            final R result;
+        chunkIndex = 0;
+        for (int start = 0; start < n; start += chunkSize, chunkIndex++) {
+            final int from = start;
+            final int to = Math.min(n, start + chunkSize);
+            final Future<R[]> chunkFuture = chunkFutures[chunkIndex];
+            final R[] results;
             try {
                 final long remaining = deadline - System.nanoTime();
                 if (remaining <= 0) {
                     throw new TimeoutException();
                 }
-                result = future.get(remaining, TimeUnit.NANOSECONDS);
-                stats.computedInTime++;
+                results = chunkFuture.get(remaining, TimeUnit.NANOSECONDS);
             } catch (final TimeoutException | ExecutionException giveUp) {
-                // Deadline missed (or the worker itself failed): drop this entity for this tick and
-                // move on. compute() must tolerate being abandoned mid-run - it never touches shared
-                // state, so an orphaned computation is wasted CPU, not a correctness problem.
-                future.cancel(true);
-                stats.timedOut++;
+                // Deadline missed (or the worker itself failed): drop this whole chunk for this tick.
+                // compute() must tolerate being abandoned mid-run - it never touches shared state, so
+                // an orphaned computation is wasted CPU, not a correctness problem.
+                chunkFuture.cancel(true);
+                stats.timedOut += to - from;
                 continue;
             } catch (final InterruptedException interrupted) {
-                // Restore the interrupt flag rather than swallowing it - this thread (the region
-                // owner thread) did not ask to stop, but whoever interrupted it might expect the
-                // usual JDK convention of the flag surviving past this catch.
                 Thread.currentThread().interrupt();
-                future.cancel(true);
-                stats.timedOut++;
+                chunkFuture.cancel(true);
+                stats.timedOut += to - from;
                 continue;
             }
 
-            // Re-validate immediately before commit - never trust snapshot-time state. This single
-            // check is what makes region merge/split, entity unload, and shutdown safe: a stale
-            // result just fails here instead of needing its own special-case handling.
-            if (!entity.isAlive() || entity.isRemoved()) {
-                stats.discardedInvalid++;
-                continue;
-            }
-            if (!Bukkit.isOwnedByCurrentRegion(entity.getBukkitEntity())) {
-                stats.discardedNotOwned++;
-                continue;
-            }
+            for (int i = from; i < to; i++) {
+                final E entity = entities.get(i);
+                final R result = results[i - from];
 
-            phase.commit(level, entity, result);
-            stats.committed++;
+                // Re-validate immediately before commit - never trust snapshot-time state. This
+                // single check is what makes region merge/split, entity unload, and shutdown safe: a
+                // stale result just fails here instead of needing its own special-case handling.
+                if (!entity.isAlive() || entity.isRemoved()) {
+                    stats.discardedInvalid++;
+                    continue;
+                }
+                if (!Bukkit.isOwnedByCurrentRegion(entity.getBukkitEntity())) {
+                    stats.discardedNotOwned++;
+                    continue;
+                }
+
+                phase.commit(level, entity, result);
+                stats.committed++;
+            }
+            stats.computedInTime += to - from;
         }
 
         return stats;
     }
+
+    /** Runs on a worker thread: pure computation over a contiguous slice of snapshots, no live state. */
+    @SuppressWarnings("unchecked")
+    private static <S, R> R[] computeChunk(final RegionParallelPhase<?, S, R> phase, final S[] snapshots, final int from, final int to) {
+        final Object[] results = new Object[to - from];
+        for (int i = from; i < to; i++) {
+            results[i - from] = phase.compute(snapshots[i]);
+        }
+        return (R[]) results;
+    }
 }
