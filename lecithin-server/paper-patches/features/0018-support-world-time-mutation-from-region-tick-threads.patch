From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Sat, 5 Sep 2026 18:37:40 +0800
Subject: [PATCH] support world time mutation from region tick threads


diff --git a/src/main/java/org/bukkit/craftbukkit/CraftWorld.java b/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
index b14a4e1437210e0375f0289b2006d73eda61f67f..18aea59281c5df5435b7358532a61e96c7231055 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
@@ -819,7 +819,13 @@ public class CraftWorld extends CraftRegionAccessor implements World {
 
     @Override
     public void setTime(long time) {
-        io.papermc.paper.threadedregions.RegionizedServer.ensureGlobalTickThread("Cannot modify time off of the global region"); // Folia - region threading
+        // Lecithin start - world time boundary support
+        if (!io.papermc.paper.threadedregions.RegionizedServer.isGlobalTickThread()
+                && !fun.bm.lecithin.compat.LecithinStartupGlobalContext.isStartupThread()
+                && !fun.bm.lecithin.compat.LecithinWorldTimeSupport.isAllowedRegionCaller()) {
+            io.papermc.paper.threadedregions.RegionizedServer.ensureGlobalTickThread("Cannot modify time off of the global region");
+        }
+        // Lecithin end - world time boundary support
         long margin = (time - this.getFullTime()) % SharedConstants.TICKS_PER_GAME_DAY;
         if (margin < 0) margin += SharedConstants.TICKS_PER_GAME_DAY;
         this.setFullTime(this.getFullTime() + margin);
@@ -827,6 +833,12 @@ public class CraftWorld extends CraftRegionAccessor implements World {
 
     @Override
     public long getFullTime() {
+        // Lecithin start - optimistic staged time for the default clock
+        final Long staged = fun.bm.lecithin.compat.LecithinWorldTimeSupport.getStagedTime(this);
+        if (staged != null) {
+            return staged;
+        }
+        // Lecithin end - optimistic staged time for the default clock
         return this.world.getDefaultClockTime();
     }
 
@@ -834,7 +846,7 @@ public class CraftWorld extends CraftRegionAccessor implements World {
     public void setFullTime(long time) {
         final Holder<net.minecraft.world.clock.WorldClock> clock = this.world.dimensionType().defaultClock()
             .orElseThrow(() -> new IllegalArgumentException("Cannot set time in world without world clock"));
-        this.setFullTime(clock, time);
+        this.setFullTime(clock, time, true); // Lecithin - default clock compatibility
     }
 
     @Override
@@ -851,20 +863,34 @@ public class CraftWorld extends CraftRegionAccessor implements World {
     @Override
     public void setFullTime(final WorldClock clock, final long time) {
         Preconditions.checkArgument(clock != null, "clock cannot be null");
-        this.setFullTime(PaperWorldClock.bukkitToMinecraftHolder(clock), time);
+        this.setFullTime(PaperWorldClock.bukkitToMinecraftHolder(clock), time, false); // Lecithin - keep explicit clock calls on the global owner
     }
 
-    private void setFullTime(final Holder<net.minecraft.world.clock.WorldClock> clock, final long time) {
-        io.papermc.paper.threadedregions.RegionizedServer.ensureGlobalTickThread("Cannot modify time off of the global region"); // Folia - region threading
+    private void setFullTime(final Holder<net.minecraft.world.clock.WorldClock> clock, final long time, final boolean defaultClockCompat) {
+        // Lecithin start - support the legacy default-clock API from the startup thread or a region caller
+        final boolean startup = defaultClockCompat && fun.bm.lecithin.compat.LecithinStartupGlobalContext.isStartupThread();
+        final boolean stage = defaultClockCompat && !startup && !io.papermc.paper.threadedregions.RegionizedServer.isGlobalTickThread()
+            && fun.bm.lecithin.compat.LecithinWorldTimeSupport.isAllowedRegionCaller();
+        if (!startup && !stage) {
+            io.papermc.paper.threadedregions.RegionizedServer.ensureGlobalTickThread("Cannot modify time off of the global region"); // Folia - region threading
+        }
+        // Lecithin end - support the legacy default-clock API from the startup thread or a region caller
         Preconditions.checkArgument(time >= 0, "time cannot be negative, was %s", time);
-        final long currentClockTime = this.world.clockManager().getInstance(clock).totalTicks();
+        final long currentClockTime = defaultClockCompat ? this.getFullTime() : this.world.clockManager().getInstance(clock).totalTicks(); // Lecithin - include a staged default-clock update
         final ClockTimeSkipEvent event = CraftEventFactory.createTimeSkipEvent(this.world, clock, ClockTimeSkipEvent.SkipReason.CUSTOM, time - currentClockTime);
         if (!event.callEvent()) {
             return;
         }
 
         // Updates the clock for all players
-        this.world.clockManager().setTotalTicks(clock, Math.max(currentClockTime + event.getSkipAmount(), 0L));
+        // Lecithin start - dispatch compatible off-global writes without blocking the owner
+        final long targetTime = Math.max(currentClockTime + event.getSkipAmount(), 0L);
+        if (stage) {
+            fun.bm.lecithin.compat.LecithinWorldTimeSupport.stageAndDispatch(this, clock, targetTime);
+        } else {
+            this.world.clockManager().setTotalTicks(clock, targetTime);
+        }
+        // Lecithin end - dispatch compatible off-global writes without blocking the owner
     }
 
     @Override
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index 8d74ebcd11fec39705fb5cd4138b47f349cd1c99..4e2ca72d1b3cf16ee37b56bb85efbfc554d8b36f 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -1578,15 +1578,20 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
 
     @Override
     public void setPlayerTime(long time, boolean tickTime) {
-        this.getHandle().timeOffset = time;
-        this.getHandle().relativeTime = tickTime;
-
-        final ServerLevel level = this.getHandle().level();
-        if (this.getHandle().connection == null || level.dimensionType().defaultClock().isEmpty()) {
-            return;
-        }
+        // Lecithin start - dispatch player time mutation to owning region
+        this.taskScheduler.scheduleOrExecute(entity -> {
+            ServerPlayer player = (ServerPlayer) entity;
+            player.timeOffset = time;
+            player.relativeTime = tickTime;
+
+            final ServerLevel level = player.level();
+            if (player.connection == null || level.dimensionType().defaultClock().isEmpty()) {
+                return;
+            }
 
-        this.getHandle().connection.send(level.clockManager().createFullSyncPacket(this.getHandle()));
+            player.connection.send(level.clockManager().createFullSyncPacket(player));
+        });
+        // Lecithin end - dispatch player time mutation to owning region
     }
 
     @Override
