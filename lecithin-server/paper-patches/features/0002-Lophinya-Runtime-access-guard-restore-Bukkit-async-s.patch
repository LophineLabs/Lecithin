+            if (bukkitScheduler instanceof org.bukkit.craftbukkit.scheduler.CraftScheduler craftScheduler) {
+                craftScheduler.lophinya$asyncHeartbeat();
+            }
+        }
+        // Lophinya end - drive the restored Bukkit async scheduler off the global tick
+
         final List<GlobalScheduledTask> run;
         synchronized (this.stateLock) {
             ++this.tickCount;
