@@ -514,7 +535,25 @@ public class CraftScheduler implements BukkitScheduler {
     }
 
     protected CraftTask handle(final CraftTask task, final long delay) { // Paper
-        if (true) throw new UnsupportedOperationException(); // Folia - region threading
+        // Lophinya start - restore Bukkit async scheduler semantics + diagnostic guard
+        // Folia replaced this whole method with an unconditional, message-less throw. That is correct
+        // for *sync* tasks (there is no main thread to run them on), but it also killed the *async*
+        // path, which never needed a main thread: Paper already runs those on CraftAsyncScheduler's
+        // own pool. Restoring it is a return to Paper semantics, not a compatibility shim - and any
+        // async task that does touch world state still hits Folia's thread-ownership checks, loudly.
+        if (!this.isAsyncScheduler && !task.isSync() && fun.bm.lophinya.compat.LophinyaCompatConfig.RESTORE_ASYNC_SCHEDULER) {
+            this.asyncScheduler.handle(task, delay);
+            return task;
+        }
+        if (this.isAsyncScheduler && fun.bm.lophinya.compat.LophinyaCompatConfig.RESTORE_ASYNC_SCHEDULER) {
+            task.setNextRun(this.currentTick + delay);
+            this.addTask(task);
+            return task;
+        }
+        throw new UnsupportedOperationException(fun.bm.lophinya.compat.LophinyaSchedulerDiagnostics.reportRejected(
+            task.getOwner(), delay, task.getPeriod(), !task.isSync()));
+        // Lophinya end - restore Bukkit async scheduler semantics + diagnostic guard
+        /* // Folia - region threading
         // Paper start
         if (!this.isAsyncScheduler && !task.isSync()) {
             this.asyncScheduler.handle(task, delay);
@@ -524,6 +563,20 @@ public class CraftScheduler implements BukkitScheduler {
         task.setNextRun(this.currentTick + delay);
         this.addTask(task);
         return task;
+        */ // Folia - region threading
+    }
+
+    /**
+     * Lophinya: advance only the async scheduler's clock.
+     * <p>{@link CraftAsyncScheduler#mainThreadHeartbeat()} increments a counter and hands the work
+     * to its own single management thread - no plugin code runs on the caller. That makes it safe
+     * to drive from Folia's global tick, which is what this exists for. Deliberately <b>not</b>
+     * {@link #mainThreadHeartbeat()}, which would also drain the sync queue.
+     */
+    public void lophinya$asyncHeartbeat() {
+        if (!this.isAsyncScheduler && this.asyncScheduler != null) {
+            this.asyncScheduler.mainThreadHeartbeat();
+        }
     }
 
     private static void validate(final Plugin plugin, final Object task) {
