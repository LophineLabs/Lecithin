+    @Test
+    public void testCommandNodeConcurrentModificationSafety() throws Exception {
+        final RootCommandNode<Object> root = new RootCommandNode<>();
+
+        // Populate initial commands
+        for (int i = 0; i < 50; i++) {
+            final LiteralCommandNode<Object> node = LiteralArgumentBuilder.literal("cmd" + i)
+                    .then(LiteralArgumentBuilder.literal("sub1"))
+                    .then(LiteralArgumentBuilder.literal("sub2"))
+                    .build();
+            root.addChild(node);
+        }
+
+        final int threads = 4;
+        final ExecutorService executor = Executors.newFixedThreadPool(threads);
+        final AtomicBoolean running = new AtomicBoolean(true);
+        final AtomicInteger npeCount = new AtomicInteger(0);
+        final AtomicInteger cmeCount = new AtomicInteger(0);
+        final CountDownLatch latch = new CountDownLatch(threads);
+        final List<Future<?>> futures = new ArrayList<>();
+
+        // Reader threads: simulating COMMAND_SENDING_POOL iterating children
+        for (int t = 0; t < 2; t++) {
+            futures.add(executor.submit(() -> {
+                latch.countDown();
+                try {
+                    latch.await();
+                    while (running.get()) {
+                        final Collection<CommandNode<Object>> children = root.getChildren();
+                        for (CommandNode<Object> child : children) {
+                            if (child == null) {
+                                npeCount.incrementAndGet();
+                                continue;
+                            }
+                            if (child.clientNode != null) {
+                                child = child.clientNode;
+                            }
+                            if (child == null) {
+                                npeCount.incrementAndGet();
+                                continue;
+                            }
+                            for (CommandNode<Object> sub : child.getChildren()) {
+                                if (sub == null) {
+                                    npeCount.incrementAndGet();
+                                    continue;
+                                }
+                                Assertions.assertNotNull(sub.getName());
+                            }
+                        }
+                    }
+                } catch (NullPointerException e) {
+                    npeCount.incrementAndGet();
+                } catch (java.util.ConcurrentModificationException e) {
+                    cmeCount.incrementAndGet();
+                } catch (InterruptedException ignored) {
+                }
+            }));
+        }
+
+        // Writer threads: simulating dynamic command registration / unregistration on server threads
+        for (int t = 0; t < 2; t++) {
+            final int writerId = t;
+            futures.add(executor.submit(() -> {
+                latch.countDown();
+                try {
+                    latch.await();
+                    int counter = 0;
+                    while (running.get()) {
+                        final String name = "dyn_" + writerId + "_" + (counter++ % 100);
+                        final LiteralCommandNode<Object> node = LiteralArgumentBuilder.literal(name)
+                                .then(LiteralArgumentBuilder.literal("arg"))
+                                .build();
+                        root.addChild(node);
+                        if (counter % 3 == 0) {
+                            root.removeCommand(name);
+                        }
+                    }
+                } catch (Exception ignored) {
+                }
+            }));
+        }
+
+        // Run concurrent load for 500ms
+        Thread.sleep(500);
+        running.set(false);
+        executor.shutdown();
+        Assertions.assertTrue(executor.awaitTermination(5, TimeUnit.SECONDS));
+
+        for (Future<?> f : futures) {
+            f.get();
+        }
+
+        Assertions.assertEquals(0, npeCount.get(), "NPE occurred during concurrent command tree reading!");
+        Assertions.assertEquals(0, cmeCount.get(), "ConcurrentModificationException occurred during command tree reading!");
+    }
