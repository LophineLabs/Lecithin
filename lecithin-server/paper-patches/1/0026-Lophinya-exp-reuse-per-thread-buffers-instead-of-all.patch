From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TinyYana <yanasakuranight@gmail.com>
Date: Wed, 5 Aug 2026 23:43:09 +0800
Subject: [PATCH] Lophinya: exp - reuse per-thread buffers instead of
 allocating every tick

RegionParallelRunner allocated a fresh snapshot array and a fresh future
array on every runPhase call; ServerLevel's shadow-run pre-pass allocated a
fresh ArrayList every tick. All three are now ThreadLocal-cached and reused
(grown, never shrunk) - safe because runPhase always runs on the region tick
thread that owns everything it touches, so a ThreadLocal buffer never crosses
regions.

Follow-up to patch 0047 (chunked submission, which cut the +88% regression to
+14.9%): this targets the remaining per-tick allocation cost identified in
project-docs/evidence/20260805-region-parallel-phase-framework-design.md 7b.

exp/* isolated exploration branch per DEC-69. Not for merge into ver/26.2-nya.

diff --git a/src/main/java/fun/bm/lophinya/parallel/RegionParallelRunner.java b/src/main/java/fun/bm/lophinya/parallel/RegionParallelRunner.java
index 0b2d3672bab405448e8d340bfc9f40b53edd97d6..5f4c41f4f2be7acf6028954e1639106cdb211904 100644
--- a/src/main/java/fun/bm/lophinya/parallel/RegionParallelRunner.java
+++ b/src/main/java/fun/bm/lophinya/parallel/RegionParallelRunner.java
@@ -65,6 +65,48 @@ public final class RegionParallelRunner {
     private RegionParallelRunner() {
     }
 
+    // Per-thread reusable buffers (2026-08-05, see project-docs/evidence/20260805-region-parallel-
+    // phase-framework-design.md 7c). runPhase is always called from the region tick thread that
+    // owns everything it is about to snapshot, so a ThreadLocal buffer never crosses regions - each
+    // region-tick thread keeps growing its own until it stops needing to. This avoids reallocating
+    // the snapshot/future arrays every single tick, which A/B measurement showed was a meaningful
+    // share of the framework's own fixed cost once the submission count itself was fixed (patch 0047).
+    private static final ThreadLocal<Object[]> SNAPSHOT_BUFFER = ThreadLocal.withInitial(() -> new Object[64]);
+    private static final ThreadLocal<Future[]> FUTURE_BUFFER = ThreadLocal.withInitial(() -> new Future[8]);
+
+    @SuppressWarnings("unchecked")
+    private static <S> S[] snapshotBuffer(final int minSize) {
+        Object[] buf = SNAPSHOT_BUFFER.get();
+        if (buf.length < minSize) {
+            buf = new Object[Math.max(minSize, buf.length * 2)];
+            SNAPSHOT_BUFFER.set(buf);
+        }
+        return (S[]) buf;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <R> Future<R>[] futureBuffer(final int minSize) {
+        Future[] buf = FUTURE_BUFFER.get();
+        if (buf.length < minSize) {
+            buf = new Future[Math.max(minSize, buf.length * 2)];
+            FUTURE_BUFFER.set(buf);
+        }
+        return (Future<R>[]) buf;
+    }
+
+    private static final ThreadLocal<java.util.ArrayList<Entity>> ENTITY_LIST_BUFFER =
+        ThreadLocal.withInitial(java.util.ArrayList::new);
+
+    /** A per-thread reusable {@code ArrayList}, cleared (not reallocated) on every call - for
+     *  callers that collect a batch of entities once per tick, same reasoning as the snapshot/future
+     *  buffers above. Caller must finish reading the returned list before calling this again on the
+     *  same thread. */
+    public static java.util.List<Entity> entityListBuffer() {
+        final java.util.ArrayList<Entity> list = ENTITY_LIST_BUFFER.get();
+        list.clear();
+        return list;
+    }
+
     /** Diagnostics for one {@link #runPhase} call. Caller reports these to whatever counters it
      *  is using (see {@code Brain#tick}'s {@code LProfilerRegistry} integration for the first
      *  wiring) - this class does not know about the profiler itself, to keep it phase-agnostic. */
@@ -92,8 +134,7 @@ public final class RegionParallelRunner {
             return stats;
         }
 
-        @SuppressWarnings("unchecked")
-        final S[] snapshots = (S[]) new Object[n];
+        final S[] snapshots = RegionParallelRunner.<S>snapshotBuffer(n);
         for (int i = 0; i < n; i++) {
             snapshots[i] = phase.snapshot(level, entities.get(i));
         }
@@ -109,8 +150,7 @@ public final class RegionParallelRunner {
         final int chunkCount = Math.max(1, Math.min(RegionParallelRunner.WORKERS, n));
         final int chunkSize = (n + chunkCount - 1) / chunkCount;
 
-        @SuppressWarnings("unchecked")
-        final Future<R[]>[] chunkFutures = new Future[chunkCount];
+        final Future<R[]>[] chunkFutures = RegionParallelRunner.<R[]>futureBuffer(chunkCount);
         int chunkIndex = 0;
         for (int start = 0; start < n; start += chunkSize, chunkIndex++) {
             final int from = start;
