@@ -0,0 +1,118 @@
+package fun.bm.lophinya.parallel.nyacore;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.level.PathNavigationRegion;
+import net.minecraft.world.level.material.Fluids;
+import net.minecraft.world.level.pathfinder.PathFinder;
+import net.minecraft.world.level.pathfinder.PathType;
+import net.minecraft.world.phys.AABB;
+
+import java.util.EnumMap;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Lophinya: an immutable, worker-safe capture of everything {@code WalkNodeEvaluator}'s search
+ * algorithm reads from a live {@code Mob} (DEC-70, NyaCore candidate C). Built once on the region
+ * owner thread by {@link #capture}; read-only from then on, including on a worker thread.
+ *
+ * <p>Field-by-field justification lives in
+ * {@code project-docs/evidence/20260806-nyacore-candidate-c-navigationsnapshot-design.md} 1b/3c -
+ * this class is that document's design turned into code, nothing here should need a new
+ * live-state read that isn't already listed there.
+ *
+ * <p>Bundles the per-request {@link PathFinder} too (step 3b: never the {@code PathNavigation}'s
+ * own long-lived instance) and the search parameters, since in practice every consumer needs the
+ * whole set together - splitting "mob capabilities" from "this specific request" bought no real
+ * isolation here.
+ */
+public record NavigationSnapshot(
+    PathNavigationRegion region,
+    PathFinder pathFinder,
+    Set<BlockPos> targets,
+    float maxPathLength,
+    int reachRange,
+    float maxVisitedNodesMultiplier,
+
+    BlockPos mobBlockPos,
+    double mobX,
+    double mobY,
+    double mobZ,
+    AABB mobBoundingBox,
+    // Deliberately separate from mobBoundingBox's X/Y size: getBbWidth()/getBbHeight() are the
+    // entity's nominal EntityDimensions, not guaranteed identical to the live bounding box (pose
+    // changes, babies, etc.) - the original this.mob.getBbWidth()/getBbHeight() call sites must be
+    // matched exactly, not approximated by deriving from the AABB.
+    float bbWidth,
+    float bbHeight,
+    boolean isInWater,
+    boolean onGround,
+    boolean canStandOnWater,
+    boolean canStandOnLava,
+    float maxUpStep,
+    int maxFallDistance,
+    int worldMinY,
+    Map<PathType, Float> pathfindingMalus,
+
+    boolean descending,
+    ItemStack heldItem
+) {
+    /** Owner-thread only. Reads {@code mob} exactly once; nothing returned holds a reference back
+     *  to it - verified by the field list above tracing 1:1 to
+     *  {@code evidence/20260806-nyacore-candidate-c-navigationsnapshot-design.md} 1a. */
+    public static NavigationSnapshot capture(
+        final Mob mob,
+        final PathNavigationRegion region,
+        final PathFinder pathFinder,
+        final Set<BlockPos> targets,
+        final float maxPathLength,
+        final int reachRange,
+        final float maxVisitedNodesMultiplier
+    ) {
+        final Map<PathType, Float> malus = new EnumMap<>(PathType.class);
+        for (final PathType pathType : PathType.values()) {
+            // Mob.getPathfindingMalus already resolves the "riding a vehicle that shares its malus
+            // table" case internally - no need to replicate that branch here, just call it once per
+            // PathType while we still have the live mob (see design doc 1a "getControlledVehicle").
+            malus.put(pathType, mob.getPathfindingMalus(pathType));
+        }
+
+        final ItemStack heldItem = mob instanceof LivingEntity living ? living.getMainHandItem().copy() : ItemStack.EMPTY;
+
+        return new NavigationSnapshot(
+            region,
+            pathFinder,
+            targets,
+            maxPathLength,
+            reachRange,
+            maxVisitedNodesMultiplier,
+            mob.blockPosition(),
+            mob.getX(),
+            mob.getY(),
+            mob.getZ(),
+            mob.getBoundingBox(),
+            mob.getBbWidth(),
+            mob.getBbHeight(),
+            mob.isInWater(),
+            mob.onGround(),
+            mob.canStandOnFluid(Fluids.WATER.defaultFluidState()),
+            mob.canStandOnFluid(Fluids.LAVA.defaultFluidState()),
+            mob.maxUpStep(),
+            mob.getMaxFallDistance(),
+            mob.level().getMinY(),
+            malus,
+            mob.isDescending(),
+            heldItem
+        );
+    }
+
+    /** Falls back to {@link PathType#getMalus()} for any type not present, matching
+     *  {@code Mob.getPathfindingMalus}'s own fallback. */
+    public float pathfindingMalus(final PathType pathType) {
+        final Float malus = this.pathfindingMalus.get(pathType);
+        return malus == null ? pathType.getMalus() : malus;
+    }
+}
diff --git a/src/main/java/fun/bm/lophinya/parallel/nyacore/SnapshotEntityCollisionContext.java b/src/main/java/fun/bm/lophinya/parallel/nyacore/SnapshotEntityCollisionContext.java
