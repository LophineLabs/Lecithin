+++ b/src/main/java/fun/bm/lophinya/parallel/nyacore/SnapshotEntityCollisionContext.java
@@ -0,0 +1,52 @@
+package fun.bm.lophinya.parallel.nyacore;
+
+import net.minecraft.tags.FluidTags;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.level.material.FluidState;
+import net.minecraft.world.phys.shapes.EntityCollisionContext;
+
+/**
+ * Lophinya: {@link EntityCollisionContext} without a live {@code Entity} reference (DEC-70, NyaCore
+ * candidate C). The vanilla constructor {@code CollisionContext.of(Entity)} stores the entity
+ * solely to answer {@link #canStandOnFluid} later - see
+ * {@code project-docs/evidence/20260806-nyacore-candidate-c-navigationsnapshot-design.md} 3d for
+ * the full trace. This class passes {@code entity = null} to the superclass (so nothing here is
+ * ever reachable from a worker thread) and overrides {@link #canStandOnFluid} to answer from two
+ * booleans captured on the owner thread instead.
+ */
+public final class SnapshotEntityCollisionContext extends EntityCollisionContext {
+
+    private final boolean canStandOnWater;
+    private final boolean canStandOnLava;
+
+    public SnapshotEntityCollisionContext(
+        final boolean descending,
+        final double entityBottom,
+        final ItemStack heldItem,
+        final boolean canStandOnWater,
+        final boolean canStandOnLava
+    ) {
+        super(descending, false, entityBottom, heldItem, false, null);
+        this.canStandOnWater = canStandOnWater;
+        this.canStandOnLava = canStandOnLava;
+    }
+
+    // Mirrors EntityCollisionContext.canStandOnFluid's real logic (entity instanceof LivingEntity
+    // && livingEntity.canStandOnFluid(fluid) && !fluidStateAbove.getType().isSame(fluid.getType())):
+    // every LivingEntity.canStandOnFluid override in the codebase (base = always false, Strider =
+    // fluid.is(LAVA)) only depends on the fluid's *type*, never other FluidState properties (level,
+    // falling), so capturing one boolean per type on the owner thread is behaviourally equivalent.
+    @Override
+    public boolean canStandOnFluid(final FluidState fluidStateAbove, final FluidState fluid) {
+        if (fluidStateAbove.getType().isSame(fluid.getType())) {
+            return false;
+        }
+        if (fluid.is(FluidTags.WATER)) {
+            return this.canStandOnWater;
+        }
+        if (fluid.is(FluidTags.LAVA)) {
+            return this.canStandOnLava;
+        }
+        return false;
+    }
+}
diff --git a/src/main/java/fun/bm/lophinya/parallel/nyacore/SnapshotWalkNodeEvaluator.java b/src/main/java/fun/bm/lophinya/parallel/nyacore/SnapshotWalkNodeEvaluator.java
new file mode 100644
index 0000000000000000000000000000000000000000..6547cfa332cdf706fb81af658f19c811d3df0c12
--- /dev/null
+++ b/src/main/java/fun/bm/lophinya/parallel/nyacore/SnapshotWalkNodeEvaluator.java
@@ -0,0 +1,183 @@
+package fun.bm.lophinya.parallel.nyacore;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.tags.FluidTags;
+import net.minecraft.util.Mth;
+import net.minecraft.world.level.border.WorldBorder;
+import net.minecraft.world.level.material.FluidState;
+import net.minecraft.world.level.pathfinder.Node;
+import net.minecraft.world.level.pathfinder.Path;
+import net.minecraft.world.level.pathfinder.PathType;
+import net.minecraft.world.level.pathfinder.PathfindingContext;
+import net.minecraft.world.level.pathfinder.WalkNodeEvaluator;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.shapes.BooleanOp;
+import net.minecraft.world.phys.shapes.Shapes;
+import net.minecraft.world.phys.shapes.VoxelShape;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * Lophinya: {@link WalkNodeEvaluator} that reads a {@link NavigationSnapshot} instead of a live
+ * {@code Mob} (DEC-70, NyaCore candidate C). Safe to run {@link #computeFromSnapshot} on a worker
+ * thread - every accessor {@code WalkNodeEvaluator} defines for exactly this purpose is overridden
+ * below, and {@code this.mob} is never set (stays {@code null} for the lifetime of this instance),
+ * so a missed override fails loudly (NPE) instead of silently reaching a live object.
+ *
+ * <p>One instance is single-use: constructed fresh per pathfinding request (see design doc 3b -
+ * never {@code PathNavigation}'s long-lived {@code PathFinder}/evaluator pair) and discarded after.
+ */
+public final class SnapshotWalkNodeEvaluator extends WalkNodeEvaluator {
+
+    private NavigationSnapshot snapshot;
+
+    /** Owner-thread-only equivalent of {@code NodeEvaluator.prepare()} - deliberately does NOT call
+     *  the real {@code prepare()} (it requires a live {@code Mob}). Safe to call this on the owner
+     *  thread only insofar as it must run before the instance crosses to a worker; nothing here
+     *  reads {@code this.mob} because {@code this.mob} is never assigned by this class. */
+    public void prepareFromSnapshot(final NavigationSnapshot snapshot) {
+        this.snapshot = snapshot;
+        this.currentContext = new PathfindingContext(snapshot.region(), snapshot.mobBlockPos());
+        this.nodes.clear();
+        this.entityWidth = Mth.floor(snapshot.bbWidth() + 1.0F);
+        this.entityHeight = Mth.floor(snapshot.bbHeight() + 1.0F);
+        this.entityDepth = Mth.floor(snapshot.bbWidth() + 1.0F);
+    }
+
+    /** Worker-thread entry point: runs the unmodified {@code WalkNodeEvaluator} search algorithm
+     *  (inherited {@code getStart()}/{@code getNeighbors()}/etc.) against only this instance's own
+     *  scratch state and the {@link NavigationSnapshot} - never a live object. Caller must have
+     *  called {@link #prepareFromSnapshot} on the owner thread first. */
+    public @Nullable Path computeFromSnapshot() {
+        final Node from = this.getStart();
+        if (from == null) {
+            return null;
+        }
+        return this.snapshot.pathFinder().findPathFromPreparedStart(
+            from, this.snapshot.targets(), this.snapshot.maxPathLength(), this.snapshot.reachRange(), this.snapshot.maxVisitedNodesMultiplier()
+        );
+    }
+
+    /** No live entity to notify and no per-search caches were ever populated by a real
+     *  {@code prepare()} beyond what this class's own fields track - just clear the per-instance
+     *  scratch caches inherited from {@code WalkNodeEvaluator}. Deliberately does not call
+     *  {@code super.done()} (it reaches {@code this.mob}, which is always null here). */
+    public void doneFromSnapshot() {
+        this.currentContext = null;
+        this.snapshot = null;
+    }
+
+    @Override
+    protected double mobX() {
+        return this.snapshot.mobX();
+    }
+
+    @Override
+    protected double mobY() {
+        return this.snapshot.mobY();
+    }
+
+    @Override
+    protected double mobZ() {
+        return this.snapshot.mobZ();
+    }
+
+    @Override
+    protected int mobBlockY() {
+        return this.snapshot.mobBlockPos().getY();
+    }
+
+    @Override
+    protected BlockPos mobBlockPosition() {
+        return this.snapshot.mobBlockPos();
+    }
+
+    @Override
+    protected boolean mobCanStandOnFluid(final FluidState fluidState) {
+        if (fluidState.is(FluidTags.WATER)) {
+            return this.snapshot.canStandOnWater();
+        }
+        if (fluidState.is(FluidTags.LAVA)) {
+            return this.snapshot.canStandOnLava();
+        }
+        return false;
+    }
+
+    @Override
+    protected boolean mobIsInWater() {
+        return this.snapshot.isInWater();
+    }
+
+    @Override
+    protected boolean mobOnGround() {
+        return this.snapshot.onGround();
+    }
+
+    @Override
+    protected AABB mobBoundingBox() {
+        return this.snapshot.mobBoundingBox();
+    }
+
+    @Override
+    protected float mobBbWidth() {
+        return this.snapshot.bbWidth();
+    }
+
+    @Override
+    protected float mobBbHeight() {
+        return this.snapshot.bbHeight();
+    }
+
+    @Override
+    protected float mobPathfindingMalus(final PathType pathType) {
+        return this.snapshot.pathfindingMalus(pathType);
+    }
+
+    @Override
+    protected float mobMaxUpStep() {
+        return this.snapshot.maxUpStep();
+    }
+
+    @Override
+    protected int mobMaxFallDistance() {
+        return this.snapshot.maxFallDistance();
+    }
+
+    @Override
+    protected int mobWorldMinY() {
+        return this.snapshot.worldMinY();
+    }
+
+    /** Full re-implementation of {@code CollisionGetter.noCollision(Entity, AABB)} against the
+     *  snapshot instead of a live entity: block collision uses a real {@link
+     *  SnapshotEntityCollisionContext}, entity collision matches {@link
+     *  net.minecraft.world.level.PathNavigationRegion#getEntityCollisions} (already always empty
+     *  in vanilla - nothing lost), and border collision is reproduced exactly using the two
+     *  x/z-only {@code WorldBorder} overloads found in the design doc 3d trace, not narrowed. */
+    @Override
+    protected boolean mobNoCollision(final AABB aabb) {
+        for (final VoxelShape shape : this.currentContext.level().getBlockCollisionsFromContext(this.snapshotCollisionContext(), aabb)) {
+            if (!shape.isEmpty()) {
+                return false;
+            }
+        }
+        // entity-vs-entity: PathNavigationRegion.getEntityCollisions() is always List.of(), matching
+        // vanilla behaviour for the sync path exactly - nothing to check here either way.
+        final WorldBorder worldBorder = this.currentContext.level().getWorldBorder();
+        double bbMax = Math.max(Mth.absMax(aabb.getXsize(), aabb.getZsize()), 1.0);
+        boolean insideCloseToBorder = worldBorder.getDistanceToBorder(this.snapshot.mobX(), this.snapshot.mobZ()) < bbMax * 2.0
+            && worldBorder.isWithinBounds(this.snapshot.mobX(), this.snapshot.mobZ(), bbMax);
+        if (insideCloseToBorder) {
+            VoxelShape borderShape = worldBorder.getCollisionShape();
+            if (Shapes.joinIsNotEmpty(borderShape, Shapes.create(aabb), BooleanOp.AND)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private SnapshotEntityCollisionContext snapshotCollisionContext() {
+        return new SnapshotEntityCollisionContext(
+            this.snapshot.descending(), this.snapshot.mobY(), this.snapshot.heldItem(), this.snapshot.canStandOnWater(), this.snapshot.canStandOnLava()
+        );
+    }
+}
