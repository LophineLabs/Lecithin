@@ -0,0 +1,93 @@
+package fun.bm.lophinya.parallel.nyacore;
+
+import fun.bm.lophinya.parallel.RegionParallelPhase;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.ai.navigation.PathNavigation;
+import net.minecraft.world.level.PathNavigationRegion;
+import net.minecraft.world.level.pathfinder.Path;
+import net.minecraft.world.level.pathfinder.PathFinder;
+
+import java.util.Set;
+
+/**
+ * Lophinya: {@link RegionParallelPhase} for one asynchronous pathfinding request (DEC-70, NyaCore
+ * candidate C). One instance per request - constructed with the specific targets/parameters a
+ * caller would otherwise have passed straight to {@code PathNavigation.createPath}, then run
+ * through {@link fun.bm.lophinya.parallel.RegionParallelRunner#runPhase} for exactly the one
+ * {@code Mob} it is for (a singleton list), reusing the framework's existing bounded queue,
+ * deadline, and ownership/lifecycle re-validation unchanged.
+ *
+ * <p>Scoped to ground navigation only for this first wiring (villager AI is the Goal's required
+ * first workload) - {@link #snapshot} always builds a {@link SnapshotWalkNodeEvaluator}, so a mob
+ * whose real navigation is not ground-based (flying/swimming) would get a wrong-shaped path. That
+ * check is the caller's responsibility until a second snapshot evaluator exists for those.
+ */
+public final class NavigationPathfindPhase implements RegionParallelPhase<Mob, NavigationSnapshot, Path> {
+
+    private final Set<BlockPos> targets;
+    private final int radiusOffset;
+    private final boolean above;
+    private final int reachRange;
+    private final float maxVisitedNodesMultiplier;
+    private final double speedModifier;
+
+    public NavigationPathfindPhase(
+        final Set<BlockPos> targets,
+        final int radiusOffset,
+        final boolean above,
+        final int reachRange,
+        final float maxVisitedNodesMultiplier,
+        final double speedModifier
+    ) {
+        this.targets = targets;
+        this.radiusOffset = radiusOffset;
+        this.above = above;
+        this.reachRange = reachRange;
+        this.maxVisitedNodesMultiplier = maxVisitedNodesMultiplier;
+        this.speedModifier = speedModifier;
+    }
+
+    // Owner thread only (RegionParallelRunner guarantee). Mirrors PathNavigation#createPath's own
+    // region-building exactly (fromPos + radius from maxPathLength), then builds a fresh,
+    // single-use SnapshotWalkNodeEvaluator/PathFinder pair (never PathNavigation's long-lived
+    // this.pathFinder - design doc 3b) and captures the NavigationSnapshot before handing off.
+    @Override
+    public NavigationSnapshot snapshot(final ServerLevel level, final Mob mob) {
+        final PathNavigation navigation = mob.getNavigation();
+        final float maxPathLength = navigation.getMaxPathLength();
+        final BlockPos fromPos = this.above ? mob.blockPosition().above() : mob.blockPosition();
+        final int radius = (int) (maxPathLength + this.radiusOffset);
+        final PathNavigationRegion region = new PathNavigationRegion(
+            level, fromPos.offset(-radius, -radius, -radius), fromPos.offset(radius, radius, radius)
+        );
+
+        final SnapshotWalkNodeEvaluator evaluator = new SnapshotWalkNodeEvaluator();
+        final PathFinder pathFinder = new PathFinder(evaluator, navigation.getMaxVisitedNodes());
+        final NavigationSnapshot snapshot = NavigationSnapshot.capture(
+            mob, region, pathFinder, this.targets, maxPathLength, this.reachRange, this.maxVisitedNodesMultiplier
+        );
+        evaluator.prepareFromSnapshot(snapshot);
+        return snapshot;
+    }
+
+    // Worker thread only. Touches nothing but the snapshot and the single-use evaluator/PathFinder
+    // it carries - see SnapshotWalkNodeEvaluator's own class doc for why a missed live-state
+    // dependency would fail loudly (NPE) here instead of silently reaching a live object.
+    @Override
+    public Path compute(final NavigationSnapshot snapshot) {
+        final SnapshotWalkNodeEvaluator evaluator = (SnapshotWalkNodeEvaluator) snapshot.pathFinder().nodeEvaluator;
+        return evaluator.computeFromSnapshot();
+    }
+
+    // Owner thread only, and only after RegionParallelRunner has re-validated the mob is still
+    // alive/not removed/still owned by the calling region (see RegionParallelRunner#runPhase). A
+    // null result (no path found) is a normal outcome, not committed as a move.
+    @Override
+    public void commit(final ServerLevel level, final Mob mob, final Path result) {
+        if (result != null) {
+            mob.getNavigation().moveTo(result, this.speedModifier);
+        }
+    }
+}
