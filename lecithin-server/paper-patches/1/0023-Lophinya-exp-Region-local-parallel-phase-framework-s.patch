+package fun.bm.lophinya.parallel;
+
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+
+/**
+ * Lophinya: a no-op {@link RegionParallelPhase}, wired into {@code Brain#tick} as the first real
+ * call site for {@link RegionParallelRunner} (DEC-69).
+ *
+ * <p>snapshot/compute/commit all do nothing. Its only job is to exercise the framework's real
+ * submit -&gt; barrier -&gt; commit-validate machinery against a real entity on a real running
+ * server, so the framework's own per-call overhead can be measured with {@code /profiler} before
+ * any actual AI sub-phase (Sensor, Goal, Navigation, Brain behavior) is attached to it. Because
+ * every method is a no-op, running this with the feature on is provably behaviour-identical to
+ * running with it off - see the A/B check required before this leaves {@code exp/*}.
+ *
+ * <p>This is deliberately NOT yet "the Sensor phase" - splitting {@code Sensor#tick} into a real
+ * snapshot/compute/commit shape is separate follow-up work
+ * ({@code 20260805-region-parallel-phase-framework-design.md} 3): most vanilla sensors read
+ * nearby-entity/world state directly inside their own {@code tick()} with no snapshot step to
+ * reuse yet.
+ */
+public final class SensorShadowPhase implements RegionParallelPhase<Entity, Void, Void> {
+
+    public static final SensorShadowPhase INSTANCE = new SensorShadowPhase();
+
+    private SensorShadowPhase() {
+    }
+
+    @Override
+    public Void snapshot(final ServerLevel level, final Entity entity) {
+        return null;
+    }
+
+    @Override
+    public Void compute(final Void snapshot) {
+        return null;
+    }
+
+    @Override
+    public void commit(final ServerLevel level, final Entity entity, final Void result) {
+        // intentionally empty
+    }
+}
