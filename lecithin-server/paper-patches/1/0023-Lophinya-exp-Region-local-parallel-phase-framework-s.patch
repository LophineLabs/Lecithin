+++ b/src/main/java/fun/bm/lophinya/parallel/RegionParallelPhase.java
@@ -0,0 +1,35 @@
+package fun.bm.lophinya.parallel;
+
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+
+/**
+ * Lophinya: a region-tick sub-phase that can run its read-only compute step on a bounded worker
+ * pool instead of the region owner thread (DEC-69, Region-local parallel phase framework).
+ *
+ * <p>Full design rationale: {@code project-docs/evidence/20260805-region-parallel-phase-framework
+ * -design.md}. The three methods below are guaranteed to run on specific threads by
+ * {@link RegionParallelRunner} - implementations must not fight that guarantee:
+ *
+ * <ul>
+ *   <li>{@link #snapshot} - the calling (region owner) thread only. This is the one place allowed
+ *       to read live world/entity state.
+ *   <li>{@link #compute} - a worker thread. Must not touch {@code Entity}, {@code ServerLevel},
+ *       any Bukkit/Paper API, or call a plugin - only the snapshot value it was given.
+ *   <li>{@link #commit} - the calling (region owner) thread only, and only after
+ *       {@link RegionParallelRunner} has re-validated the entity is still alive, not removed, and
+ *       still owned by the calling region. This is the only place allowed to mutate anything.
+ * </ul>
+ *
+ * @param <E> the entity type this phase operates on
+ * @param <S> the immutable snapshot type produced on the owner thread and consumed by a worker
+ * @param <R> the result type produced by a worker and consumed back on the owner thread
+ */
+public interface RegionParallelPhase<E extends Entity, S, R> {
+
+    S snapshot(ServerLevel level, E entity);
+
+    R compute(S snapshot);
+
+    void commit(ServerLevel level, E entity, R result);
+}
diff --git a/src/main/java/fun/bm/lophinya/parallel/RegionParallelRunner.java b/src/main/java/fun/bm/lophinya/parallel/RegionParallelRunner.java
new file mode 100644
index 0000000000000000000000000000000000000000..a7776d4cafaa50673273e6eb9e3b16aff8fbf46d
--- /dev/null
+++ b/src/main/java/fun/bm/lophinya/parallel/RegionParallelRunner.java
@@ -0,0 +1,156 @@
+package fun.bm.lophinya.parallel;
+
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+import org.bukkit.Bukkit;
+
+import java.util.List;
+import java.util.concurrent.ArrayBlockingQueue;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.Future;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+
+/**
+ * Lophinya: bounded, server-wide driver for {@link RegionParallelPhase} (DEC-69).
+ *
+ * <p>Shape: region owner thread builds an immutable snapshot per entity -&gt; bounded workers
+ * compute in parallel -&gt; owner thread waits with a hard deadline -&gt; owner thread re-validates
+ * and commits. Full rationale: {@code project-docs/evidence/20260805-region-parallel-phase-
+ * framework-design.md}.
+ *
+ * <h2>Safety invariants (do not relax without a corresponding DECISIONS.md entry)</h2>
+ * <ul>
+ *   <li>{@code snapshot()} and {@code commit()} only ever run on the calling thread - the region
+ *       owner thread that called {@link #runPhase}. Never dispatched anywhere else.
+ *   <li>{@code compute()} never receives an {@code Entity}, {@code ServerLevel}, or any Bukkit/
+ *       Paper handle - only the snapshot value. It cannot touch live state even by accident.
+ *   <li>The queue is bounded ({@link RegionParallelConfig#QUEUE_CAPACITY}); a full queue means
+ *       immediate synchronous fallback on the calling thread, never a wait for room.
+ *   <li>The barrier wait has a hard deadline ({@link RegionParallelConfig#DEADLINE_NANOS}); a
+ *       result not ready by then is dropped, never awaited past it. The region tick thread must
+ *       never block indefinitely - see the {@code folia-economy-harness} incident recorded in
+ *       {@code SESSION_HANDOFF.md} 8 (an unconditional {@code CountDownLatch.await()} inside a
+ *       {@code RegionScheduler} task froze the whole server, because that task <i>is</i> the
+ *       region's tick).
+ *   <li>Every result is re-validated (alive, not removed, still owned by the calling region)
+ *       immediately before {@code commit()} - never trusted from snapshot time. This is what
+ *       makes region merge/split, entity unload, and shutdown safe without any special-case code
+ *       for those situations: a stale result simply fails this check and gets dropped.
+ * </ul>
+ *
+ * <p>The worker pool is shared across every region on the server, not one pool per region - on a
+ * small (e.g. 4 vCore) box, per-region pools would starve each other and the existing region/
+ * global/network executors, which the Goal this framework was built for explicitly forbids.
+ */
+public final class RegionParallelRunner {
+
+    private static final int WORKERS = Math.max(1,
+        Runtime.getRuntime().availableProcessors() - RegionParallelConfig.RESERVED_THREADS);
+
+    private static final ThreadPoolExecutor POOL = new ThreadPoolExecutor(
+        WORKERS, WORKERS, 60L, TimeUnit.SECONDS,
+        new ArrayBlockingQueue<>(RegionParallelConfig.QUEUE_CAPACITY),
+        runnable -> {
+            final Thread t = new Thread(runnable, "Lophinya Region Parallel Worker");
+            t.setDaemon(true);
+            return t;
+        },
+        new ThreadPoolExecutor.AbortPolicy() // caller catches RejectedExecutionException -> sync fallback, never blocks
+    );
+
+    private RegionParallelRunner() {
+    }
+
+    /** Diagnostics for one {@link #runPhase} call. Caller reports these to whatever counters it
+     *  is using (see {@code Brain#tick}'s {@code LProfilerRegistry} integration for the first
+     *  wiring) - this class does not know about the profiler itself, to keep it phase-agnostic. */
+    public static final class Stats {
+        public int submitted;
+        public int rejectedQueueFull;
+        public int computedInTime;
+        public int timedOut;
+        public int discardedInvalid;
+        public int discardedNotOwned;
+        public int committed;
+    }
+
+    /**
+     * Runs {@code phase} for every entity in {@code entities}. Must be called from the thread that
+     * currently owns the region ticking all of them - that thread is where {@code snapshot()} and
+     * {@code commit()} run.
+     */
+    public static <E extends Entity, S, R> Stats runPhase(
+        final ServerLevel level, final List<E> entities, final RegionParallelPhase<E, S, R> phase
+    ) {
+        final Stats stats = new Stats();
+        final int n = entities.size();
+        if (n == 0) {
+            return stats;
+        }
+
+        @SuppressWarnings("unchecked")
+        final S[] snapshots = (S[]) new Object[n];
+        for (int i = 0; i < n; i++) {
+            snapshots[i] = phase.snapshot(level, entities.get(i));
+        }
+
+        @SuppressWarnings("unchecked")
+        final Future<R>[] futures = new Future[n];
+        for (int i = 0; i < n; i++) {
+            final S snap = snapshots[i];
+            try {
+                futures[i] = POOL.submit(() -> phase.compute(snap));
+                stats.submitted++;
+            } catch (final RejectedExecutionException poolFull) {
+                // Queue is full and every worker is busy: do not wait for room, compute right here
+                // on the calling thread instead. This is the "bounded queue, no unbounded backlog"
+                // requirement - a full queue degrades to synchronous, it never blocks.
+                futures[i] = CompletableFuture.completedFuture(phase.compute(snap));
+                stats.rejectedQueueFull++;
+            }
+        }
+
+        final long deadline = System.nanoTime() + RegionParallelConfig.DEADLINE_NANOS;
+        for (int i = 0; i < n; i++) {
+            final E entity = entities.get(i);
+            final Future<R> future = futures[i];
+            final R result;
+            try {
+                final long remaining = deadline - System.nanoTime();
+                if (remaining <= 0) {
+                    throw new TimeoutException();
+                }
+                result = future.get(remaining, TimeUnit.NANOSECONDS);
+                stats.computedInTime++;
+            } catch (final TimeoutException | InterruptedException | ExecutionException giveUp) {
+                // Deadline missed (or the worker itself failed): drop this entity for this tick and
+                // move on. compute() must tolerate being abandoned mid-run - it never touches shared
+                // state, so an orphaned computation is wasted CPU, not a correctness problem.
+                future.cancel(true);
+                stats.timedOut++;
+                continue;
+            }
+
+            // Re-validate immediately before commit - never trust snapshot-time state. This single
+            // check is what makes region merge/split, entity unload, and shutdown safe: a stale
+            // result just fails here instead of needing its own special-case handling.
+            if (!entity.isAlive() || entity.isRemoved()) {
+                stats.discardedInvalid++;
+                continue;
+            }
+            if (!Bukkit.isOwnedByCurrentRegion(entity.getBukkitEntity())) {
+                stats.discardedNotOwned++;
+                continue;
+            }
+
+            phase.commit(level, entity, result);
+            stats.committed++;
+        }
+
+        return stats;
+    }
+}
