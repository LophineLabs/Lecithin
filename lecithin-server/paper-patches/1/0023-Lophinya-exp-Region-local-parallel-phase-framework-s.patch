+package fun.bm.lophinya.parallel;
+
+/**
+ * Lophinya: kill switches for the Region-local parallel phase framework (DEC-69).
+ *
+ * <p>System properties, not YAML, same reasoning as {@code LophinyaCompatConfig}: every one of
+ * these is a rollback lever you can pull from the start script.
+ *
+ * <pre>
+ *   -Dlophinya.parallel.enabled=true      # master switch. DEFAULT OFF - Goal requires this
+ *   -Dlophinya.parallel.sensorShadow=false # disables the sensor shadow-run sub-feature specifically
+ * </pre>
+ *
+ * <p>This is deliberately a separate property namespace from {@code lophinya.compat.*}: those are
+ * plugin-compatibility shims (the project's core product); this is a new, distinct performance
+ * research area reactivated by {@code DECISIONS.md} {@code DEC-69}, not a compatibility fix.
+ */
+public final class RegionParallelConfig {
+
+    /** Master switch. Off by default per the Goal that reactivated this research (DEC-69). */
+    public static final boolean ENABLED =
+        "true".equalsIgnoreCase(System.getProperty("lophinya.parallel.enabled", "false"));
+
+    /**
+     * The first wired sub-feature: run a no-op phase through the full snapshot/submit/barrier/
+     * commit-validate pipeline for the entity {@link net.minecraft.world.entity.ai.Brain#tick}
+     * is about to process, without changing anything it does. Purpose is to measure the
+     * framework's own per-call overhead before any real phase (Sensor, Goal, ...) is attached -
+     * see project-docs/evidence/20260805-region-parallel-phase-framework-design.md 4.
+     */
+    public static final boolean SENSOR_SHADOW_ENABLED =
+        ENABLED && !"false".equalsIgnoreCase(System.getProperty("lophinya.parallel.sensorShadow", "true"));
+
+    /** Worker pool size: total minus this many, floor 1. Reserves cores for the existing region
+     *  pool / global work pool / network executor so this framework cannot starve them on a small
+     *  box (Goal explicitly forbids that). */
+    public static final int RESERVED_THREADS =
+        Integer.getInteger("lophinya.parallel.reservedThreads", 2);
+
+    /** Bounded queue capacity for the shared worker pool. Full queue means immediate synchronous
+     *  fallback on the calling thread, never a wait - see RegionParallelRunner. */
+    public static final int QUEUE_CAPACITY =
+        Integer.getInteger("lophinya.parallel.queueCapacity", 256);
+
+    /** Hard deadline for the barrier wait, in nanoseconds. Chosen well under a 50ms tick budget so
+     *  a full pool cannot itself cause the region thread to miss its tick. */
+    public static final long DEADLINE_NANOS =
+        Long.getLong("lophinya.parallel.deadlineNanos", 5_000_000L); // 5ms
+
+    private RegionParallelConfig() {
+    }
+}
diff --git a/src/main/java/fun/bm/lophinya/parallel/RegionParallelPhase.java b/src/main/java/fun/bm/lophinya/parallel/RegionParallelPhase.java
